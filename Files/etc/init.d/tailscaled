#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# tailscaled - Tailscale 守护进程（旁路由子网路由，TUN 模式）
#
# 为什么用官方静态二进制而不是 apk/opkg：ImmortalWRT SNAPSHOT 软件源里没有 tailscale，
# 而内核 kmod-tun 已随镜像提供。二进制放 /overlay（不烧 squashfs，省镜像体积），
# 由 /usr/share/buffy/tailscale_bootstrap.sh 在刷机/开机后幂等补齐。
#
# 关键坑（26.11.19 实机踩过）：不要为 tailscale0 建 network interface（proto=none）。
# netifd 接管接口时会 flush 掉 tailscaled 自己配置的 100.x/32 地址，local 表缺该地址，
# 回程包被默认路由送到主路由后丢失，表现为「外网能连进来但会话建立不起来」。
# 防火墙区域必须用 option device 'tailscale0' 直绑设备，见 92-buffy-firewall.sh。
USE_PROCD=1
START=99
STOP=10

TS_DIR=/overlay/tailscale

start_service() {
	[ -x "$TS_DIR/tailscaled" ] || {
		# 首次开机/刷机后二进制还没下载：静默退出，bootstrap 完成后会显式 start
		logger -t tailscaled "未找到 $TS_DIR/tailscaled，等待 tailscale_bootstrap.sh 补齐"
		return 0
	}

	# UDP GRO 转发优化（Tailscale 官方建议）：子网路由的转发路径上开启
	# rx-udp-gro-forwarding 可提升直连/中继的 UDP 吞吐。br-lan 不支持时静默跳过；
	# 不依赖 ethtool 持久化配置，每次启动重设即可。
	command -v ethtool >/dev/null 2>&1 && \
		ethtool -K br-lan rx-udp-gro-forwarding on 2>/dev/null

	mkdir -p /var/run/tailscale
	procd_open_instance
	procd_set_param command "$TS_DIR/tailscaled" \
		--state="$TS_DIR/tailscaled.state" \
		--socket=/var/run/tailscale/tailscaled.sock \
		--port=41641
	# 二进制缺失时 procd 不会自动重试启动（命令不存在），故 bootstrap 补齐后会显式
	# 调用本脚本 start；respawn 只负责进程崩溃后的自愈。
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
