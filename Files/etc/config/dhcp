
config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lan/'
	option domain 'lan'
	option expandhosts '1'
	option min_cache_ttl '3600'
	option use_stale_cache '3600'
	# 注意：不要调大 dnsmasq 缓存。OpenClash 的 disable_masq_cache=1 会在看门狗里
	# 把 cachesize 强制清零（让所有 DNS 都经 clash，避免 fake-ip 映射陈旧）。
	option cachesize '0'
	option nonegcache '1'
	option quietdhcp '1'
	option strictorder '1'
	list rebind_domain 'cn.ntp.org.cn'
	# 旁路由：本机不是子网的 DHCP 权威（主路由 192.168.1.1 才是）。authoritative=1 会让
	# dnsmasq 对本机「没见过」的主机名直接 NXDOMAIN 而不转上游，经主路由取址的设备就解析不到。
	option authoritative '0'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option localservice '1'
	option dns_redirect '1'
	option ednspacket_max '1232'
	# 旁路由只走 IPv4：主路由已关 IPv6，这里再丢掉 AAAA，避免客户端拿到真实 IPv6
	# 绕过 fake-ip 分流（OpenClash ipv6_dns=0 / 覆写模块 dns.ipv6=false 与此一致）。
	option filter_aaaa '1'
	option filter_a '0'
	option sequential_ip '1'
	option noresolv '1'
	option localuse '1'
	list server '127.0.0.1#7874'

# 旁路由：只关 DHCP/RA/NDP，不能整段 ignore='1' —— 那样 dnsmasq 不再绑到 br-lan，
# 客户端就无法把 DNS 指向 192.168.1.2 走 OpenClash fake-ip，接管链路直接断。
# 地址/网关/IPv6 仍由主路由下发；需要走代理的客户端自行把「网关 + DNS」填成 192.168.1.2。
config dhcp 'lan'
	option interface 'lan'
	option dhcpv4 'disabled'
	option ra 'disabled'
	option dhcpv6 'disabled'
	option ndp 'disabled'

config odhcpd 'odhcpd'
	option leasefile '/tmp/odhcpd.leases'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
	option piodir '/tmp/odhcpd-piodir'
	option hostsdir '/tmp/hosts'

# 不放 host/MAC 绑定：dhcpv4 已 disabled 时，`config host` 只生成 dhcp-host= 行、不产生任何
# DNS 记录（26.11.06 实机：`nslookup <name>.lan 127.0.0.1` 全 NXDOMAIN）。地址与主机名以主路由
# 的绑定表为唯一权威。真要本地域名解析，来源是 /etc/ethers（readethers=1 已开，与 DHCP 无关）。

