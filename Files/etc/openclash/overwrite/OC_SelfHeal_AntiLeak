#!NAME = OC_SelfHeal_AntiLeak
#!DESC = 代理组 60s 健康检查 + 空组回退直连 + provider 每小时刷新 + 关闭 IPv6 DNS
#!CONFIG = all

# 说明（16-overwrite-module-format.md §16.1/§16.2）：
# - [General] 在 yml_change.sh 之前写 UCI，等价于在 LuCI 里改插件设置；
# - [YAML] 在 yml_change.sh / yml_rules_change.sh 之后合并进运行配置，优先于订阅原值；
# - 段头必须有；本文件随固件镜像发布，首启由 /etc/uci-defaults/93-buffy-openclash.sh 登记。

[General]
ENABLE_RESPECT_RULES = 1
APPEND_WAN_DNS = 0
IPV6_ENABLE = 0
IPV6_DNS = 0

[YAML]
dns:
  ipv6: false
proxy-providers*:
  where:
    type: http
  set:
    interval: 3600
    health-check:
      enable: true
      url: 'https://cp.cloudflare.com/generate_204'
      interval: 60
      timeout: 5000
      lazy: false
      expected-status: 204
<proxy-groups>*:
  where:
    type: '/^(url-test|fallback|load-balance)$/'
  set:
    lazy: false
    interval: 60
    timeout: 5000
    expected-status: 204
    empty-fallback: DIRECT
