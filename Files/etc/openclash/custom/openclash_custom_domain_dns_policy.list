# OpenClash 自定义 nameserver-policy（需 openclash.config.custom_name_policy=1）
# 目的：国外域名走 nameserver（经代理的境外 DoH），国内/私有/苹果域名走国内 DoH 直连，
# 既消除 DNS 泄漏（权威侧不再看到国内 ISP 解析器），又保留国内 CDN 就近解析。
"geosite:cn,private,apple":
  - https://doh.pub/dns-query
  - https://dns.alidns.com/dns-query

# 引导域名（订阅源 / 规则源）：必须走国内 DNS 直连。
# 否则 fake-ip-filter 里的域名仍会用 nameserver（境外 DoH，经代理）解析 ——
# 代理没起来时形成死锁：拉不到订阅 → 没有节点 → 代理起不来。
"+.tohno-0.top":
  - https://dns.alidns.com/dns-query
  - https://doh.pub/dns-query
"+.de5.net":
  - https://dns.alidns.com/dns-query
  - https://doh.pub/dns-query
"+.github.com":
  - https://dns.alidns.com/dns-query
  - https://doh.pub/dns-query
"+.githubusercontent.com":
  - https://dns.alidns.com/dns-query
  - https://doh.pub/dns-query
"+.jsdelivr.net":
  - https://dns.alidns.com/dns-query
  - https://doh.pub/dns-query
"+.aisaka-taiga.com":
  - https://dns.alidns.com/dns-query
  - https://doh.pub/dns-query
