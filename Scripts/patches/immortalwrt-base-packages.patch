new file mode 100644
index 0000000..ac1de60
--- /dev/null
+++ b/package/libs/libffi/Makefile
@@ -0,0 +1,91 @@
+#
+# Copyright (C) 2009-2016 OpenWrt.org
+#
+# This is free software, licensed under the GNU General Public License v2.
+# See /LICENSE for more information.
+#
+
+include $(TOPDIR)/rules.mk
+
+PKG_NAME:=libffi
+PKG_VERSION:=3.8.0
+PKG_RELEASE:=1
+
+PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
+PKG_SOURCE_URL:=https://github.com/libffi/libffi/releases/download/v$(PKG_VERSION)
+PKG_HASH:=7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4
+
+PKG_LICENSE:=MIT
+PKG_LICENSE_FILES:=LICENSE
+PKG_CPE_ID:=cpe:/a:libffi_project:libffi
+
+PKG_INSTALL:=1
+PKG_BUILD_PARALLEL:=1
+PKG_BUILD_FLAGS:=no-mips16
+
+include $(INCLUDE_DIR)/package.mk
+include $(INCLUDE_DIR)/host-build.mk
+
+define Package/libffi
+  SECTION:=libs
+  CATEGORY:=Libraries
+  TITLE:=Foreign Function Interface (FFI) library
+  URL:=https://sourceware.org/libffi/
+  MAINTAINER:=Peter Wagner <tripolar@gmx.at>
+endef
+
+define Package/libffi/description
+The libffi library provides a portable, high level programming interface to
+various calling conventions. This allows a programmer to call any function
+specified by a call interface description at run-time.
+
+FFI stands for Foreign Function Interface. A foreign function interface is the
+popular name for the interface that allows code written in one language to call
+code written in another language. The libffi library really only provides the
+lowest, machine dependent layer of a fully featured foreign function interface.
+A layer must exist above libffi that handles type conversions for values passed
+between the two languages.
+endef
+
+HOST_CONFIGURE_ARGS += \
+	--disable-shared \
+	--disable-docs \
+	--disable-multi-os-directory \
+	--disable-raw-api \
+	--disable-structs \
+	--with-pic
+
+CONFIGURE_ARGS += \
+	--disable-docs \
+	--disable-multi-os-directory \
+	--disable-raw-api \
+	--disable-structs
+
+define Build/InstallDev
+	$(INSTALL_DIR) $(1)/usr/lib/pkgconfig
+	$(CP) \
+		$(PKG_INSTALL_DIR)/usr/lib/libffi.{so*,a,la} \
+		$(1)/usr/lib/
+	$(CP) \
+		$(PKG_INSTALL_DIR)/usr/lib/pkgconfig/* \
+		$(1)/usr/lib/pkgconfig/
+	$(SED) 's,includedir=.*,includedir=$$$${prefix}/include,' $(1)/usr/lib/pkgconfig/libffi.pc
+
+	$(INSTALL_DIR) $(1)/usr/include
+	$(CP) \
+		$(PKG_INSTALL_DIR)/usr/include/*.h \
+		$(1)/usr/include/
+	$(CP) \
+		$(PKG_BUILD_DIR)/$(GNU_TARGET_NAME)*/fficonfig.h \
+		$(1)/usr/include/
+endef
+
+define Package/libffi/install
+	$(INSTALL_DIR) $(1)/usr/lib
+	$(CP) \
+		$(PKG_INSTALL_DIR)/usr/lib/libffi.so.* \
+		$(1)/usr/lib/
+endef
+
+$(eval $(call HostBuild))
+$(eval $(call BuildPackage,libffi))
diff --git a/package/libs/libffi/patches/001-arm-fix-big-endian-sub-word-argument-offsets-in-closures.patch b/package/libs/libffi/patches/001-arm-fix-big-endian-sub-word-argument-offsets-in-closures.patch
new file mode 100644
index 0000000..7815242
--- /dev/null
+++ b/package/libs/libffi/patches/001-arm-fix-big-endian-sub-word-argument-offsets-in-closures.patch
@@ -0,0 +1,51 @@
+From 2b53369681cc85094e936efe18e27bff2d63f4c0 Mon Sep 17 00:00:00 2001
+From: Janis Gertulla <coffeeimpliescode@proton.me>
+Date: Tue, 18 Aug 2026 06:46:29 +0200
+Subject: [PATCH] arm: fix big-endian sub-word argument offsets in closures
+
+Sub-4-byte integer args passed in 32-bit registers or on the stack sit
+in the LSB of the 4-byte slot, which on big-endian ARM is at offset
+4 - size. Previously assumed little-endian (offset 0). Adjust in
+ffi_prep_incoming_args_SYSV and ffi_prep_incoming_args_VFP.
+---
+ src/arm/ffi.c | 15 +++++++++++++++
+ 1 file changed, 15 insertions(+)
+
+--- a/src/arm/ffi.c
++++ b/src/arm/ffi.c
+@@ -467,6 +467,11 @@ ffi_prep_incoming_args_SYSV (ffi_cif *ci
+       size_t z = ty->size;
+ 
+       argp = ffi_align (ty, argp);
++#ifdef __ARMEB__
++      if (z < 4 && ty->type != FFI_TYPE_STRUCT)
++	avalue[i] = (void *) (argp + 4 - z);
++      else
++#endif
+       avalue[i] = (void *) argp;
+       argp += z;
+     }
+@@ -515,6 +520,11 @@ ffi_prep_incoming_args_VFP (ffi_cif *cif
+ 	  if (tregp + z <= eo_regp || !stack_used)
+ 	    {
+ 	      /* Because we're little endian, this is what it turns into.  */
++#ifdef __ARMEB__
++	      if (z < 4 && ty->type != FFI_TYPE_STRUCT)
++		avalue[i] = (void *) (tregp + 4 - z);
++	      else
++#endif
+ 	      avalue[i] = (void *) tregp;
+ 	      regp = tregp + z;
+ 
+@@ -537,6 +547,11 @@ ffi_prep_incoming_args_VFP (ffi_cif *cif
+ 
+       stack_used = 1;
+       argp = ffi_align (ty, argp);
++#ifdef __ARMEB__
++      if (z < 4 && ty->type != FFI_TYPE_STRUCT)
++	avalue[i] = (void *) (argp + 4 - z);
++      else
++#endif
+       avalue[i] = (void *) argp;
+       argp += z;
+     }
diff --git a/package/libs/libffi/patches/002-closures-handle-page-size-lookup-failure.patch b/package/libs/libffi/patches/002-closures-handle-page-size-lookup-failure.patch
new file mode 100644
index 0000000..c371bfa
--- /dev/null
+++ b/package/libs/libffi/patches/002-closures-handle-page-size-lookup-failure.patch
@@ -0,0 +1,27 @@
+From 1877747a8966a9466802b8f807f4dec9141f9a48 Mon Sep 17 00:00:00 2001
+From: huangwenbin <huangwenbin@kylinos.cn>
+Date: Mon, 31 Aug 2026 17:29:27 +0800
+Subject: [PATCH] closures: handle page size lookup failure
+
+allocate_space() uses the value returned by sysconf(_SC_PAGESIZE)
+as the size of a local buffer without checking for failure.
+
+Return early when the page size lookup fails or produces an invalid
+value, avoiding creation of an invalid variable-length array.
+
+Signed-off-by: huangwenbin <huangwenbin@kylinos.cn>
+---
+ src/closures.c | 2 ++
+ 1 file changed, 2 insertions(+)
+
+--- a/src/closures.c
++++ b/src/closures.c
+@@ -800,6 +800,8 @@ allocate_space (int fd, off_t len)
+   /* Obtain system page size. */
+   if (!page_size)
+     page_size = sysconf(_SC_PAGESIZE);
++  if (page_size <= 0)
++    return -1;
+ 
+   unsigned char buf[page_size];
+   memset (buf, 0, page_size);
diff --git a/package/libs/libffi/patches/003-powerpc64-fix-_Complex-long-double-when-long-double-is-64-bits.patch b/package/libs/libffi/patches/003-powerpc64-fix-_Complex-long-double-when-long-double-is-64-bits.patch
new file mode 100644
index 0000000..ee2b041
--- /dev/null
+++ b/package/libs/libffi/patches/003-powerpc64-fix-_Complex-long-double-when-long-double-is-64-bits.patch
@@ -0,0 +1,73 @@
+From c043378d261d0a32e966fb5622ff36fbf9eaed95 Mon Sep 17 00:00:00 2001
+From: Anthony Green <green@moxielogic.com>
+Date: Tue, 15 Sep 2026 07:34:00 -0400
+Subject: [PATCH] powerpc64: fix _Complex long double when long double is 64
+ bits
+
+PR #1003 added _Complex long double support for the IBM-128 and IEEE-128
+formats, but it read "not IEEE-128" as "IBM-128" and so assumed
+sizeof(long double) == 16 wherever FFI_TYPE_LONGDOUBLE != FFI_TYPE_DOUBLE.
+On powerpc that condition says nothing about the width: HAVE_LONG_DOUBLE_VARIANT
+forces HAVE_LONG_DOUBLE on, and the actual width comes from the
+FFI_LINUX_LONG_DOUBLE_128 bit of the ABI at runtime.
+
+Targets with a distinct but 64-bit long double -- musl ppc64le, or any build
+with -mlong-double-64 -- therefore counted 4 FPRs and 4 GPR shadow slots for
+each _Complex long double argument and read four doubles out of a 16-byte
+value, crashing complex_longdouble, return_complex1_longdouble,
+return_complex2_longdouble and cls_complex_va_longdouble.
+
+Normalize the complex element type to FFI_TYPE_DOUBLE when the ABI says long
+double is 64 bits, as discover_homogeneous_aggregate and both _Complex return
+paths already do, letting the existing double code handle those values.  The
+three argument paths fixed here were the only ones that hardcoded the IBM-128
+width; the rest are driven by rtype->size or by the element count from
+discover_homogeneous_aggregate and were already correct.
+
+Reported and diagnosed by Janis Gertulla, who also proposed a fix.
+
+Fixes #1013
+
+Co-authored-by: Janis Gertulla <coffeeimpliescode@proton.me>
+Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
+---
+ src/powerpc/ffi_linux64.c | 14 ++++++++++++++
+ 1 file changed, 14 insertions(+)
+
+--- a/src/powerpc/ffi_linux64.c
++++ b/src/powerpc/ffi_linux64.c
+@@ -393,6 +393,12 @@ homogeneous:
+ 	     under ELFv2, and is what differentiates _Complex from a
+ 	     same-sized struct{T;T;} which uses fewer GPR shadow slots.  */
+ 	  elt = (*ptr)->elements[0]->type;
++#if FFI_TYPE_LONGDOUBLE != FFI_TYPE_DOUBLE
++	  /* A 64-bit long double is passed exactly like a double.  */
++	  if (elt == FFI_TYPE_LONGDOUBLE
++	      && (cif->abi & FFI_LINUX_LONG_DOUBLE_128) == 0)
++	    elt = FFI_TYPE_DOUBLE;
++#endif
+ 	  switch (elt)
+ 	    {
+ 	    case FFI_TYPE_FLOAT:
+@@ -776,6 +782,10 @@ ffi_prep_args64 (extended_cif *ecif, uns
+ 	case FFI_TYPE_COMPLEX:
+ 	  elt = (*ptr)->elements[0]->type;
+ #if FFI_TYPE_LONGDOUBLE != FFI_TYPE_DOUBLE
++	  /* A 64-bit long double is passed exactly like a double.  */
++	  if (elt == FFI_TYPE_LONGDOUBLE
++	      && (ecif->cif->abi & FFI_LINUX_LONG_DOUBLE_128) == 0)
++	    elt = FFI_TYPE_DOUBLE;
+ 	  if (elt == FFI_TYPE_LONGDOUBLE
+ 	      && (ecif->cif->abi & FFI_LINUX_LONG_DOUBLE_IEEE128) != 0)
+ 	    {
+@@ -1398,6 +1408,10 @@ ffi_closure_helper_LINUX64 (ffi_cif *cif
+ 	    unsigned int j;
+ 	    elt = arg_types[i]->elements[0]->type;
+ #if FFI_TYPE_LONGDOUBLE != FFI_TYPE_DOUBLE
++	    /* A 64-bit long double arrives exactly like a double.  */
++	    if (elt == FFI_TYPE_LONGDOUBLE
++		&& (cif->abi & FFI_LINUX_LONG_DOUBLE_128) == 0)
++	      elt = FFI_TYPE_DOUBLE;
+ 	    if (elt == FFI_TYPE_LONGDOUBLE
+ 		&& (cif->abi & FFI_LINUX_LONG_DOUBLE_IEEE128) != 0)
+ 	      {
diff --git a/package/libs/libffi/patches/004-powerpc64-keep-_Complex-long-double-in-step-with-the-abi-s-long-double.patch b/package/libs/libffi/patches/004-powerpc64-keep-_Complex-long-double-in-step-with-the-abi-s-long-double.patch
new file mode 100644
index 0000000..b92ab33
--- /dev/null
+++ b/package/libs/libffi/patches/004-powerpc64-keep-_Complex-long-double-in-step-with-the-abi-s-long-double.patch
@@ -0,0 +1,147 @@
+From 5cad43c09f09c24fe94b41298afb3b20495d4576 Mon Sep 17 00:00:00 2001
+From: Anthony Green <green@moxielogic.com>
+Date: Wed, 16 Sep 2026 06:15:21 -0400
+Subject: [PATCH] powerpc64: keep _Complex long double in step with the abi's
+ long double
+
+ffi_prep_types_linux64() rewrites ffi_type_longdouble to 8 or 16 bytes
+according to the FFI_LINUX_LONG_DOUBLE_128 bit of the abi it is handed.  That
+hook, and the fact that ffi_type_longdouble is one of only two non-const
+ffi_type objects on this target, exist so that a single libffi can describe
+calls into libraries built with either long double width.
+
+ffi_type_complex_longdouble is the other non-const one, for the same reason,
+but was never updated: its size and alignment stayed frozen at whatever
+sizeof(_Complex long double) was when libffi itself was compiled.  A caller
+asking for the other width therefore got a type that disagreed with its own
+element -- an element of 8 bytes inside an aggregate still claiming 32 -- which
+matters twice over:
+
+  - ffi_call_int() completes a floating-point small-struct return with
+    memcpy (rvalue, smst_buffer, cif->rtype->size), so the return value is
+    copied at the build-time size.  On a 128-bit build handed the 64-bit abi
+    that writes 32 bytes into a 16-byte value; the other way around it
+    truncates the imaginary half.
+
+  - initialize_aggregate() sizes and aligns struct members from ->size and
+    ->alignment, so any struct containing a _Complex long double comes out the
+    build-time size and ffi_get_struct_offsets() reports wrong offsets.
+
+Derive both fields from ffi_type_longdouble, which the same function has just
+set.  No test reached this because the testsuite only ever passes
+FFI_DEFAULT_ABI, where the frozen size happens to be correct, so add one that
+checks the types agree at each width the hook distinguishes and that a struct
+built from the complex type matches.  Verified on ppc64le under emulation: the
+new test aborts against a library without this change and passes with it, on
+both a 128-bit and a -mlong-double-64 build, and it is unsupported off
+powerpc64.
+
+Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
+---
+ src/powerpc/ffi_linux64.c                     | 11 +++
+ testsuite/Makefile.am                         |  1 +
+ .../libffi.complex/complex_longdouble_abi.c   | 68 +++++++++++++++++++
+ 3 files changed, 80 insertions(+)
+ create mode 100644 testsuite/libffi.complex/complex_longdouble_abi.c
+
+--- a/src/powerpc/ffi_linux64.c
++++ b/src/powerpc/ffi_linux64.c
+@@ -61,6 +61,17 @@ ffi_prep_types_linux64 (ffi_abi abi)
+       ffi_type_longdouble.size = 16;
+       ffi_type_longdouble.alignment = 16;
+     }
++#ifdef FFI_TARGET_HAS_COMPLEX_TYPE
++  /* _Complex long double is two halves of whatever long double just became.
++     Its size comes from sizeof(_Complex long double) at build time, which is
++     only right for the ABI libffi itself was built for, so keep it in step.
++     Leaving it behind makes the type disagree with its own element: a caller
++     that asks for the other long double width would get a return value copied
++     at cif->rtype->size (wrong by 16 bytes either way) and structs containing
++     the type laid out to the build-time size.  */
++  ffi_type_complex_longdouble.size = 2 * ffi_type_longdouble.size;
++  ffi_type_complex_longdouble.alignment = ffi_type_longdouble.alignment;
++#endif
+ }
+ #endif
+ 
+--- a/testsuite/Makefile.am
++++ b/testsuite/Makefile.am
+@@ -84,6 +84,7 @@ EXTRA_DIST = config/default.exp emscript
+ 	libffi.complex/complex.exp libffi.complex/complex.inc libffi.complex/complex_defs_double.inc \
+ 	libffi.complex/complex_defs_float.inc libffi.complex/complex_defs_longdouble.inc libffi.complex/complex_double.c \
+ 	libffi.complex/complex_float.c libffi.complex/complex_i128.c libffi.complex/complex_int.c libffi.complex/complex_longdouble.c \
++	libffi.complex/complex_longdouble_abi.c \
+ 	libffi.complex/ffitest.h libffi.complex/many_complex.inc libffi.complex/many_complex_double.c \
+ 	libffi.complex/many_complex_float.c libffi.complex/many_complex_longdouble.c libffi.complex/return_complex.inc \
+ 	libffi.complex/return_complex1.inc libffi.complex/return_complex1_double.c libffi.complex/return_complex1_float.c \
+--- /dev/null
++++ b/testsuite/libffi.complex/complex_longdouble_abi.c
+@@ -0,0 +1,68 @@
++/* Area:	ffi_prep_types
++   Purpose:	Check that _Complex long double follows the abi's long double width.
++   Limitations:	powerpc64 only -- the one target where long double has more
++		than one width at run time.
++   PR:		none.
++   Originator:	Anthony Green 20260916	 */
++
++/* { dg-do run { target powerpc64*-*-linux-gnu* } } */
++
++#include "ffitest.h"
++
++/* ffi_prep_cif() and ffi_get_struct_offsets() resize ffi_type_longdouble to
++   match the FFI_LINUX_LONG_DOUBLE_128 bit of the abi they are handed, so that
++   one libffi can describe calls into libraries built with either width.  That
++   is also why these two types, alone among the ffi_type objects, are not
++   const.  ffi_type_complex_longdouble has to keep up: two halves of whatever
++   long double currently is.  */
++
++static void
++check_width (ffi_abi abi, size_t ld_size, unsigned short ld_align)
++{
++  ffi_cif cif;
++  ffi_type *args[1];
++  ffi_type *elements[2];
++  ffi_type s;
++  size_t offsets[1];
++
++  args[0] = &ffi_type_complex_longdouble;
++  CHECK (ffi_prep_cif (&cif, abi, 1, &ffi_type_complex_longdouble, args)
++	 == FFI_OK);
++
++  CHECK (ffi_type_longdouble.size == ld_size);
++  CHECK (ffi_type_longdouble.alignment == ld_align);
++
++  CHECK (ffi_type_complex_longdouble.size == 2 * ld_size);
++  CHECK (ffi_type_complex_longdouble.alignment == ld_align);
++  CHECK (ffi_type_complex_longdouble.elements[0]->size == ld_size);
++
++  /* A struct built out of that type has to come out the same size, which is
++     what ffi_get_struct_offsets() and every struct-passing path rely on.  */
++  elements[0] = &ffi_type_complex_longdouble;
++  elements[1] = NULL;
++  s.size = 0;
++  s.alignment = 0;
++  s.type = FFI_TYPE_STRUCT;
++  s.elements = elements;
++  CHECK (ffi_get_struct_offsets (abi, &s, offsets) == FFI_OK);
++  CHECK (s.size == 2 * ld_size);
++  CHECK (offsets[0] == 0);
++}
++
++int
++main (void)
++{
++  size_t native = (FFI_DEFAULT_ABI & FFI_LINUX_LONG_DOUBLE_128) ? 16 : 8;
++
++  /* A 64-bit long double, as musl selects on ppc64le.  */
++  check_width ((ffi_abi) FFI_LINUX, 8, 8);
++  /* A 128-bit long double, either IBM-128 or IEEE-128.  */
++  check_width ((ffi_abi) (FFI_LINUX | FFI_LINUX_LONG_DOUBLE_128), 16, 16);
++  /* Leave the globals as this build's default abi found them.  */
++  check_width (FFI_DEFAULT_ABI, native, (unsigned short) native);
++
++  printf ("success\n");
++  exit (0);
++}
++
++/* { dg-output "success" } */
diff --git a/package/libs/libffi/patches/005-testsuite-check-complex-arguments-when-argument-registers-run-low.patch b/package/libs/libffi/patches/005-testsuite-check-complex-arguments-when-argument-registers-run-low.patch
new file mode 100644
index 0000000..9c1eb6b
--- /dev/null
+++ b/package/libs/libffi/patches/005-testsuite-check-complex-arguments-when-argument-registers-run-low.patch
@@ -0,0 +1,229 @@
+From dff6b142cef03fbba747344496abeb5941e1fe6b Mon Sep 17 00:00:00 2001
+From: Daniel Golle <daniel@makrotopia.org>
+Date: Tue, 20 Oct 2026 22:57:49 +0000
+Subject: [PATCH] testsuite: check complex arguments when argument registers
+ run low
+
+The complex tests pass at most a few complex values in a row, so they never
+reach the argument-passing rules that apply once registers start to run
+out.  Those rules differ from the plain cases on several targets:
+
+  - On RISC-V and LoongArch a complex float is passed like a struct of two
+    reals: in two FPRs if two are free, otherwise in integer registers as a
+    whole.  It is never split between an FPR and a GPR.
+  - On 32-bit PowerPC SysV a two-word complex value takes an even/odd GPR
+    pair like long long, and a larger one either fits completely into the
+    remaining GPRs or goes to the stack, which also moves every later
+    argument to the stack.
+
+Add complex_regs_{float,double,longdouble}, which pass a complex value
+after seven doubles, after five ints, and after eight doubles and eight
+ints, followed by an int, and check the result both through ffi_call and
+through a closure.
+Assisted-by: LLM
+Signed-off-by: Daniel Golle <daniel@makrotopia.org>
+---
+ testsuite/Makefile.am                         |   3 +-
+ testsuite/libffi.complex/complex_regs.inc     | 142 ++++++++++++++++++
+ .../libffi.complex/complex_regs_double.c      |   9 ++
+ testsuite/libffi.complex/complex_regs_float.c |   9 ++
+ .../libffi.complex/complex_regs_longdouble.c  |   9 ++
+ 5 files changed, 171 insertions(+), 1 deletion(-)
+ create mode 100644 testsuite/libffi.complex/complex_regs.inc
+ create mode 100644 testsuite/libffi.complex/complex_regs_double.c
+ create mode 100644 testsuite/libffi.complex/complex_regs_float.c
+ create mode 100644 testsuite/libffi.complex/complex_regs_longdouble.c
+
+--- a/testsuite/Makefile.am
++++ b/testsuite/Makefile.am
+@@ -84,7 +84,8 @@ EXTRA_DIST = config/default.exp emscript
+ 	libffi.complex/complex.exp libffi.complex/complex.inc libffi.complex/complex_defs_double.inc \
+ 	libffi.complex/complex_defs_float.inc libffi.complex/complex_defs_longdouble.inc libffi.complex/complex_double.c \
+ 	libffi.complex/complex_float.c libffi.complex/complex_i128.c libffi.complex/complex_int.c libffi.complex/complex_longdouble.c \
+-	libffi.complex/complex_longdouble_abi.c \
++	libffi.complex/complex_longdouble_abi.c libffi.complex/complex_regs.inc libffi.complex/complex_regs_double.c \
++	libffi.complex/complex_regs_float.c libffi.complex/complex_regs_longdouble.c \
+ 	libffi.complex/ffitest.h libffi.complex/many_complex.inc libffi.complex/many_complex_double.c \
+ 	libffi.complex/many_complex_float.c libffi.complex/many_complex_longdouble.c libffi.complex/return_complex.inc \
+ 	libffi.complex/return_complex1.inc libffi.complex/return_complex1_double.c libffi.complex/return_complex1_float.c \
+--- /dev/null
++++ b/testsuite/libffi.complex/complex_regs.inc
+@@ -0,0 +1,142 @@
++/* -*-c-*- */
++#include "ffitest.h"
++#include <complex.h>
++
++/* A complex argument that arrives when the argument registers are nearly
++   used up.  Seven doubles leave one floating-point argument register on
++   RISC-V and LoongArch, so the complex value has to move to integer
++   registers as a whole.  Five ints leave an odd number of GPRs on 32-bit
++   PowerPC, where a two-word complex skips to the next even register pair
++   and a larger one goes to the stack, followed by every later argument.
++   Eight doubles and eight ints push the complex value onto the stack on
++   every target.  */
++
++typedef _Complex T_C_TYPE C;
++
++static C
++fn_d7 (double d1, double d2, double d3, double d4, double d5, double d6,
++       double d7, C c, int k)
++{
++  return c * k + (d1 + d2 + d3 + d4 + d5 + d6 + d7);
++}
++
++static C
++fn_i5 (int i1, int i2, int i3, int i4, int i5, C c, int k)
++{
++  return c * k + (i1 + i2 + i3 + i4 + i5);
++}
++
++static C
++fn_d8i8 (double d1, double d2, double d3, double d4, double d5, double d6,
++	 double d7, double d8, int i1, int i2, int i3, int i4, int i5, int i6,
++	 int i7, int i8, C c, int k)
++{
++  return c * k + (d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8
++		  + i1 + i2 + i3 + i4 + i5 + i6 + i7 + i8);
++}
++
++/* SHAPE[0] doubles, SHAPE[1] ints, then the complex value and an int.  */
++static void
++cls_fn (ffi_cif *cif __UNUSED__, void *resp, void **args, void *userdata)
++{
++  const int *shape = (const int *) userdata;
++  T_C_TYPE s = 0;
++  int i, n = 0;
++
++  for (i = 0; i < shape[0]; i++)
++    s += *(double *) args[n++];
++  for (i = 0; i < shape[1]; i++)
++    s += *(int *) args[n++];
++  *(C *) resp = *(C *) args[n] * *(int *) args[n + 1] + s;
++}
++
++static void
++check (const char *name, C got, C want)
++{
++  printf ("%s: %.3f,%.3fi (want %.3f,%.3fi)\n", name,
++	  T_CONV creal (got), T_CONV cimag (got),
++	  T_CONV creal (want), T_CONV cimag (want));
++  CHECK (creal (got) == creal (want));
++  CHECK (cimag (got) == cimag (want));
++}
++
++static void
++prep (ffi_cif *cif, ffi_type **types, void **values, int nd, int ni,
++      double *d, int *i, C *c, int *k)
++{
++  int j, n = 0;
++
++  for (j = 0; j < nd; j++, n++)
++    {
++      types[n] = &ffi_type_double;
++      values[n] = &d[j];
++    }
++  for (j = 0; j < ni; j++, n++)
++    {
++      types[n] = &ffi_type_sint;
++      values[n] = &i[j];
++    }
++  types[n] = &T_FFI_TYPE;
++  values[n++] = c;
++  types[n] = &ffi_type_sint;
++  values[n++] = k;
++  CHECK (ffi_prep_cif (cif, FFI_DEFAULT_ABI, n, &T_FFI_TYPE, types) == FFI_OK);
++}
++
++int
++main (void)
++{
++  static const int shape_d7[2] = { 7, 0 };
++  static const int shape_i5[2] = { 0, 5 };
++  static const int shape_d8i8[2] = { 8, 8 };
++  double d[8] = { 1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5 };
++  int i[8] = { 10, 20, 30, 40, 50, 60, 70, 80 };
++  C c = 1.25 + 2.5 * I;
++  int k = 77;
++  ffi_type *types[18];
++  void *values[18];
++  ffi_cif cif;
++  ffi_closure *pcl;
++  void *code;
++  C r;
++
++  pcl = ffi_closure_alloc (sizeof (ffi_closure), &code);
++  CHECK (pcl != NULL);
++
++  prep (&cif, types, values, 7, 0, d, i, &c, &k);
++  ffi_call (&cif, FFI_FN (fn_d7), &r, values);
++  check ("call d7", r, fn_d7 (d[0], d[1], d[2], d[3], d[4], d[5], d[6], c, k));
++  CHECK (ffi_prep_closure_loc (pcl, &cif, cls_fn, (void *) shape_d7, code)
++	 == FFI_OK);
++  r = ((C (*)(double, double, double, double, double, double, double, C,
++	      int)) code) (d[0], d[1], d[2], d[3], d[4], d[5], d[6], c, k);
++  check ("closure d7", r,
++	 fn_d7 (d[0], d[1], d[2], d[3], d[4], d[5], d[6], c, k));
++
++  prep (&cif, types, values, 0, 5, d, i, &c, &k);
++  ffi_call (&cif, FFI_FN (fn_i5), &r, values);
++  check ("call i5", r, fn_i5 (i[0], i[1], i[2], i[3], i[4], c, k));
++  CHECK (ffi_prep_closure_loc (pcl, &cif, cls_fn, (void *) shape_i5, code)
++	 == FFI_OK);
++  r = ((C (*)(int, int, int, int, int, C, int)) code)
++    (i[0], i[1], i[2], i[3], i[4], c, k);
++  check ("closure i5", r, fn_i5 (i[0], i[1], i[2], i[3], i[4], c, k));
++
++  prep (&cif, types, values, 8, 8, d, i, &c, &k);
++  ffi_call (&cif, FFI_FN (fn_d8i8), &r, values);
++  check ("call d8i8", r,
++	 fn_d8i8 (d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7],
++		  i[0], i[1], i[2], i[3], i[4], i[5], i[6], i[7], c, k));
++  CHECK (ffi_prep_closure_loc (pcl, &cif, cls_fn, (void *) shape_d8i8, code)
++	 == FFI_OK);
++  r = ((C (*)(double, double, double, double, double, double, double, double,
++	      int, int, int, int, int, int, int, int, C, int)) code)
++    (d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7],
++     i[0], i[1], i[2], i[3], i[4], i[5], i[6], i[7], c, k);
++  check ("closure d8i8", r,
++	 fn_d8i8 (d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7],
++		  i[0], i[1], i[2], i[3], i[4], i[5], i[6], i[7], c, k));
++
++  ffi_closure_free (pcl);
++  exit (0);
++}
+--- /dev/null
++++ b/testsuite/libffi.complex/complex_regs_double.c
+@@ -0,0 +1,9 @@
++/* Area:	ffi_call, closure_call
++   Purpose:	Check complex arguments after the argument registers run low.
++   Limitations:	none.
++   PR:		none.  */
++
++/* { dg-do run } */
++
++#include "complex_defs_double.inc"
++#include "complex_regs.inc"
+--- /dev/null
++++ b/testsuite/libffi.complex/complex_regs_float.c
+@@ -0,0 +1,9 @@
++/* Area:	ffi_call, closure_call
++   Purpose:	Check complex arguments after the argument registers run low.
++   Limitations:	none.
++   PR:		none.  */
++
++/* { dg-do run } */
++
++#include "complex_defs_float.inc"
++#include "complex_regs.inc"
+--- /dev/null
++++ b/testsuite/libffi.complex/complex_regs_longdouble.c
+@@ -0,0 +1,9 @@
++/* Area:	ffi_call, closure_call
++   Purpose:	Check complex arguments after the argument registers run low.
++   Limitations:	none.
++   PR:		none.  */
++
++/* { dg-do run } */
++
++#include "complex_defs_longdouble.inc"
++#include "complex_regs.inc"
diff --git a/package/libs/libffi/patches/006-testsuite-check-integer-complex-types-smaller-than-a-register.patch b/package/libs/libffi/patches/006-testsuite-check-integer-complex-types-smaller-than-a-register.patch
new file mode 100644
index 0000000..b603c78
--- /dev/null
+++ b/package/libs/libffi/patches/006-testsuite-check-integer-complex-types-smaller-than-a-register.patch
@@ -0,0 +1,194 @@
+From 6452020c205cb88eca00a1865619e64860da5ed0 Mon Sep 17 00:00:00 2001
+From: Daniel Golle <daniel@makrotopia.org>
+Date: Tue, 20 Oct 2026 23:48:34 +0000
+Subject: [PATCH] testsuite: check integer complex types smaller than a
+ register
+
+complex_int.c defines a _Complex unsigned char type but only uses
+_Complex int, so nothing tests complex values that fit into a single
+register or stack slot.  Several targets pass and return those
+differently from the larger complex types, e.g. right-justified within
+the register.
+
+Add complex_int_small, which passes and returns _Complex signed char and
+_Complex short through ffi_call and through closures, both in registers
+and, after eight ints, on the stack.
+Assisted-by: LLM
+Signed-off-by: Daniel Golle <daniel@makrotopia.org>
+---
+ testsuite/Makefile.am                        |   2 +-
+ testsuite/libffi.complex/complex_int_small.c | 157 +++++++++++++++++++
+ 2 files changed, 158 insertions(+), 1 deletion(-)
+ create mode 100644 testsuite/libffi.complex/complex_int_small.c
+
+--- a/testsuite/Makefile.am
++++ b/testsuite/Makefile.am
+@@ -83,7 +83,7 @@ EXTRA_DIST = config/default.exp emscript
+ 	libffi.complex/cls_complex_va_double.c libffi.complex/cls_complex_va_float.c libffi.complex/cls_complex_va_longdouble.c \
+ 	libffi.complex/complex.exp libffi.complex/complex.inc libffi.complex/complex_defs_double.inc \
+ 	libffi.complex/complex_defs_float.inc libffi.complex/complex_defs_longdouble.inc libffi.complex/complex_double.c \
+-	libffi.complex/complex_float.c libffi.complex/complex_i128.c libffi.complex/complex_int.c libffi.complex/complex_longdouble.c \
++	libffi.complex/complex_float.c libffi.complex/complex_i128.c libffi.complex/complex_int.c libffi.complex/complex_int_small.c libffi.complex/complex_longdouble.c \
+ 	libffi.complex/complex_longdouble_abi.c libffi.complex/complex_regs.inc libffi.complex/complex_regs_double.c \
+ 	libffi.complex/complex_regs_float.c libffi.complex/complex_regs_longdouble.c \
+ 	libffi.complex/ffitest.h libffi.complex/many_complex.inc libffi.complex/many_complex_double.c \
+--- /dev/null
++++ b/testsuite/libffi.complex/complex_int_small.c
+@@ -0,0 +1,157 @@
++/* Area:	ffi_call, closure_call
++   Purpose:	Check integer complex types smaller than a register.
++   Limitations:	none.
++   PR:		none.  */
++
++/* { dg-do run } */
++
++#include "ffitest.h"
++#include <complex.h>
++
++/* _Complex signed char and _Complex short are passed and returned in a
++   single register or stack slot on most targets, which for complex values
++   is a different code path from the larger types.  The last function
++   passes both after eight ints, so that they go to the stack on targets
++   with eight argument registers.  */
++
++#define FFI_COMPLEX_TYPEDEF(name, type, ffitype)	     \
++  static ffi_type *ffi_elements_complex_##name [2] = {	     \
++    (ffi_type *)(&ffitype), NULL			     \
++  };							     \
++  struct struct_align_complex_##name {			     \
++    char c;						     \
++    _Complex type x;					     \
++  };							     \
++  static ffi_type ffi_type_complex_##name = {		     \
++    sizeof(_Complex type),				     \
++    offsetof(struct struct_align_complex_##name, x),	     \
++    FFI_TYPE_COMPLEX,					     \
++    (ffi_type **)ffi_elements_complex_##name		     \
++  }
++
++FFI_COMPLEX_TYPEDEF(schar, signed char, ffi_type_schar);
++FFI_COMPLEX_TYPEDEF(sshort, short, ffi_type_sshort);
++
++typedef _Complex signed char cc;
++typedef _Complex short cs;
++
++static cc
++f_cc (cc a, int k)
++{
++  __real__ a = __real__ a * k;
++  __imag__ a = __imag__ a - k;
++  return a;
++}
++
++static cs
++f_cs (cs a, int k)
++{
++  __real__ a = __real__ a * k;
++  __imag__ a = __imag__ a - k;
++  return a;
++}
++
++static cs
++f_stack (int i1, int i2, int i3, int i4, int i5, int i6, int i7, int i8,
++	 cc a, cs b)
++{
++  __real__ b = __real__ b + __real__ a + i1 + i2 + i3 + i4;
++  __imag__ b = __imag__ b + __imag__ a + i5 + i6 + i7 + i8;
++  return b;
++}
++
++static void
++cls_cc (ffi_cif *cif __UNUSED__, void *resp, void **args,
++	void *userdata __UNUSED__)
++{
++  *(cc *) resp = f_cc (*(cc *) args[0], *(int *) args[1]);
++}
++
++static void
++cls_cs (ffi_cif *cif __UNUSED__, void *resp, void **args,
++	void *userdata __UNUSED__)
++{
++  *(cs *) resp = f_cs (*(cs *) args[0], *(int *) args[1]);
++}
++
++static void
++cls_stack (ffi_cif *cif __UNUSED__, void *resp, void **args,
++	   void *userdata __UNUSED__)
++{
++  *(cs *) resp = f_stack (*(int *) args[0], *(int *) args[1],
++			  *(int *) args[2], *(int *) args[3],
++			  *(int *) args[4], *(int *) args[5],
++			  *(int *) args[6], *(int *) args[7],
++			  *(cc *) args[8], *(cs *) args[9]);
++}
++
++int
++main (void)
++{
++  ffi_cif cif;
++  ffi_type *types[10];
++  void *values[10];
++  ffi_closure *pcl;
++  void *code;
++  int ints[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };
++  cc a, ra;
++  cs b, rb;
++  int k = 3, i;
++
++  pcl = ffi_closure_alloc (sizeof (ffi_closure), &code);
++  CHECK (pcl != NULL);
++
++  __real__ a = 5;
++  __imag__ a = -7;
++  __real__ b = 300;
++  __imag__ b = -400;
++
++  types[0] = &ffi_type_complex_schar;
++  types[1] = &ffi_type_sint;
++  values[0] = &a;
++  values[1] = &k;
++  CHECK (ffi_prep_cif (&cif, FFI_DEFAULT_ABI, 2, &ffi_type_complex_schar,
++		       types) == FFI_OK);
++  ffi_call (&cif, FFI_FN (f_cc), &ra, values);
++  printf ("cc: %d,%di\n", (int) __real__ ra, (int) __imag__ ra);
++  CHECK (__real__ ra == 15 && __imag__ ra == -10);
++  CHECK (ffi_prep_closure_loc (pcl, &cif, cls_cc, NULL, code) == FFI_OK);
++  ra = ((cc (*)(cc, int)) code) (a, k);
++  printf ("closure cc: %d,%di\n", (int) __real__ ra, (int) __imag__ ra);
++  CHECK (__real__ ra == 15 && __imag__ ra == -10);
++
++  types[0] = &ffi_type_complex_sshort;
++  values[0] = &b;
++  CHECK (ffi_prep_cif (&cif, FFI_DEFAULT_ABI, 2, &ffi_type_complex_sshort,
++		       types) == FFI_OK);
++  ffi_call (&cif, FFI_FN (f_cs), &rb, values);
++  printf ("cs: %d,%di\n", (int) __real__ rb, (int) __imag__ rb);
++  CHECK (__real__ rb == 900 && __imag__ rb == -403);
++  CHECK (ffi_prep_closure_loc (pcl, &cif, cls_cs, NULL, code) == FFI_OK);
++  rb = ((cs (*)(cs, int)) code) (b, k);
++  printf ("closure cs: %d,%di\n", (int) __real__ rb, (int) __imag__ rb);
++  CHECK (__real__ rb == 900 && __imag__ rb == -403);
++
++  for (i = 0; i < 8; i++)
++    {
++      types[i] = &ffi_type_sint;
++      values[i] = &ints[i];
++    }
++  types[8] = &ffi_type_complex_schar;
++  values[8] = &a;
++  types[9] = &ffi_type_complex_sshort;
++  values[9] = &b;
++  CHECK (ffi_prep_cif (&cif, FFI_DEFAULT_ABI, 10, &ffi_type_complex_sshort,
++		       types) == FFI_OK);
++  ffi_call (&cif, FFI_FN (f_stack), &rb, values);
++  printf ("stack: %d,%di\n", (int) __real__ rb, (int) __imag__ rb);
++  CHECK (__real__ rb == 315 && __imag__ rb == -381);
++  CHECK (ffi_prep_closure_loc (pcl, &cif, cls_stack, NULL, code) == FFI_OK);
++  rb = ((cs (*)(int, int, int, int, int, int, int, int, cc, cs)) code)
++    (1, 2, 3, 4, 5, 6, 7, 8, a, b);
++  printf ("closure stack: %d,%di\n", (int) __real__ rb, (int) __imag__ rb);
++  CHECK (__real__ rb == 315 && __imag__ rb == -381);
++
++  ffi_closure_free (pcl);
++  exit (0);
++}
