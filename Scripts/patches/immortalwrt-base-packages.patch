diff --git a/package/libs/libffi/patches/010-powerpc64-fix-big-endian-ELFv2-closure-returns-of-1-to-4-byte-structs.patch b/package/libs/libffi/patches/010-powerpc64-fix-big-endian-ELFv2-closure-returns-of-1-to-4-byte-structs.patch
new file mode 100644
index 0000000..24fe238
--- /dev/null
+++ b/package/libs/libffi/patches/010-powerpc64-fix-big-endian-ELFv2-closure-returns-of-1-to-4-byte-structs.patch
@@ -0,0 +1,110 @@
+From 93ab6af85e78bb98e331692875193145645c58fd Mon Sep 17 00:00:00 2001
+From: Daniel Golle <daniel@makrotopia.org>
+Date: Tue, 20 Oct 2026 23:37:11 +0000
+Subject: [PATCH] powerpc64: fix big-endian ELFv2 closure returns of 1- to
+ 4-byte structs
+
+ELFv2 returns a struct of up to 8 bytes right-justified in r3.  The
+closure function stores it at the start of the return value area, in
+its normal memory layout, so on big-endian the closure assembly has to
+load the struct from offset 0 and shift it right.  That is what
+PPC64_LD_STRUCT_5/6/7 do, but structs of 1, 2 and 4 bytes use the jump
+table entries for integer return values, which load from the end of the
+doubleword where an integer widened to ffi_arg is.  PPC64_LD_STRUCT_3
+loads from offset 4 and shifts by the contents of r8.
+
+The integer entries were introduced for structs when the closure return
+handling moved from assembly to C, replacing the old shift of the first
+doubleword by 8 - size bytes.  Restore that behaviour with entries for
+1-, 2- and 4-byte structs on big-endian, which alias the integer entries
+on little-endian as before, and make PPC64_LD_STRUCT_3 load and shift
+the doubleword like the others.
+
+This fixes cls_1_1byte, cls_2byte, cls_3_1byte, cls_3byte1, cls_3byte2,
+cls_4_1byte, cls_4byte, single_entry_structs1 and single_entry_structs3,
+and the struct-returning callbacks in libffi.bhaible/test-callback, on
+big-endian ELFv2 (musl powerpc64, e5500 under qemu-user).
+
+Fixes: 840add3b6a1c ("Add conditional target support for __int128 (#951)")
+Assisted-by: LLM
+Signed-off-by: Daniel Golle <daniel@makrotopia.org>
+---
+ src/powerpc/ffi_linux64.c     |  6 +++---
+ src/powerpc/ffi_powerpc.h     |  6 ++++++
+ src/powerpc/linux64_closure.S | 19 +++++++++++++++++--
+ 3 files changed, 26 insertions(+), 5 deletions(-)
+
+--- a/src/powerpc/ffi_linux64.c
++++ b/src/powerpc/ffi_linux64.c
+@@ -1649,13 +1649,13 @@ ffi_closure_helper_LINUX64 (ffi_cif *cif
+ 		case 0:
+ 		  return PPC_LD_NONE;
+ 		case 1:
+-		  return PPC_LD_U8;
++		  return PPC64_LD_STRUCT_1;
+ 		case 2:
+-		  return PPC_LD_U16;
++		  return PPC64_LD_STRUCT_2;
+ 		case 3:
+ 		  return PPC64_LD_STRUCT_3;
+ 		case 4:
+-		  return PPC_LD_U32;
++		  return PPC64_LD_STRUCT_4;
+ 		case 5:
+ 		  return PPC64_LD_STRUCT_5;
+ 		case 6:
+--- a/src/powerpc/ffi_powerpc.h
++++ b/src/powerpc/ffi_powerpc.h
+@@ -84,11 +84,17 @@
+ #define PPC64_LD_STRUCT_5	PPC_LD_I64
+ #define PPC64_LD_STRUCT_6	PPC_LD_I64
+ #define PPC64_LD_STRUCT_7	PPC_LD_I64
++#define PPC64_LD_STRUCT_1	PPC_LD_U8
++#define PPC64_LD_STRUCT_2	PPC_LD_U16
++#define PPC64_LD_STRUCT_4	PPC_LD_U32
+ #else
+ #define PPC64_LD_STRUCT_3	16
+ #define PPC64_LD_STRUCT_5	17
+ #define PPC64_LD_STRUCT_6	18
+ #define PPC64_LD_STRUCT_7	19
++#define PPC64_LD_STRUCT_1	20
++#define PPC64_LD_STRUCT_2	21
++#define PPC64_LD_STRUCT_4	22
+ #endif
+ 
+ #endif /* POWERPC64 */
+--- a/src/powerpc/linux64_closure.S
++++ b/src/powerpc/linux64_closure.S
+@@ -342,8 +342,8 @@ E PPC64_LD_DOUBLE_HOMOG
+ 
+ #ifndef __LITTLE_ENDIAN__
+ E PPC64_LD_STRUCT_3
+-	lwz %r3, RETVAL+4(%r1)
+-	srd %r3, %r3, 8
++	ld %r3, RETVAL+0(%r1)
++	srdi %r3, %r3, 40
+ 	epilogue
+ 
+ E PPC64_LD_STRUCT_5
+@@ -360,6 +360,21 @@ E PPC64_LD_STRUCT_7
+ 	ld %r3, RETVAL+0(%r1)
+ 	srdi %r3, %r3, 8
+ 	epilogue
++
++E PPC64_LD_STRUCT_1
++	ld %r3, RETVAL+0(%r1)
++	srdi %r3, %r3, 56
++	epilogue
++
++E PPC64_LD_STRUCT_2
++	ld %r3, RETVAL+0(%r1)
++	srdi %r3, %r3, 48
++	epilogue
++
++E PPC64_LD_STRUCT_4
++	ld %r3, RETVAL+0(%r1)
++	srdi %r3, %r3, 32
++	epilogue
+ #endif
+ 
+ .Lmoredouble:
diff --git a/package/libs/libffi/patches/011-powerpc-fix-big-endian-SVR4-closure-returns-of-1-and-2-byte-structs.patch b/package/libs/libffi/patches/011-powerpc-fix-big-endian-SVR4-closure-returns-of-1-and-2-byte-structs.patch
new file mode 100644
index 0000000..00d23a8
--- /dev/null
+++ b/package/libs/libffi/patches/011-powerpc-fix-big-endian-SVR4-closure-returns-of-1-and-2-byte-structs.patch
@@ -0,0 +1,86 @@
+From ba994921506147dfeb2f38ad4d2874a5bd6e4f09 Mon Sep 17 00:00:00 2001
+From: Daniel Golle <daniel@makrotopia.org>
+Date: Tue, 20 Oct 2026 23:37:11 +0000
+Subject: [PATCH] powerpc: fix big-endian SVR4 closure returns of 1- and 2-byte
+ structs
+
+With FFI_SYSV_STRUCT_RET a struct of up to 8 bytes is returned in r3/r4,
+right-justified if smaller than 4 bytes.  The closure function stores it
+at the start of the return value area, but closures returning a 1- or
+2-byte struct use the PPC_LD_U8 and PPC_LD_U16 jump table entries, which
+on big-endian load from offset 3 and 2, where an integer widened to
+ffi_arg is.
+
+Before the closure return handling moved from assembly to C, these
+structs were loaded from offset 0.  Add PPC32_SYSV_LD_STRUCT_1 and
+PPC32_SYSV_LD_STRUCT_2 entries that do so again on big-endian, and alias
+them to the integer entries on little-endian.  PPC32_SYSV_LD_STRUCT_7
+now branches to .Lstruct567 instead of falling through into it, so that
+the new entries follow it in the table.
+
+FFI_SYSV_STRUCT_RET is not the default on Linux, so the testsuite does
+not cover it.  Verified by building cls_1_1byte, cls_2byte and the other
+small struct closure tests with -msvr4-struct-return -D__SVR4_STRUCT_RETURN
+for 8548 and 464fp under qemu-user: cls_1_1byte and cls_2byte abort
+without this change and pass with it, the others pass either way.
+
+Fixes: 840add3b6a1c ("Add conditional target support for __int128 (#951)")
+Assisted-by: LLM
+Signed-off-by: Daniel Golle <daniel@makrotopia.org>
+---
+ src/powerpc/ffi_powerpc.h |  4 ++++
+ src/powerpc/ffi_sysv.c    |  4 ++--
+ src/powerpc/ppc_closure.S | 10 +++++++++-
+ 3 files changed, 15 insertions(+), 3 deletions(-)
+
+--- a/src/powerpc/ffi_powerpc.h
++++ b/src/powerpc/ffi_powerpc.h
+@@ -60,11 +60,15 @@
+ #define PPC32_SYSV_LD_STRUCT_5	PPC32_LD_R3R4
+ #define PPC32_SYSV_LD_STRUCT_6	PPC32_LD_R3R4
+ #define PPC32_SYSV_LD_STRUCT_7	PPC32_LD_R3R4
++#define PPC32_SYSV_LD_STRUCT_1	PPC_LD_U8
++#define PPC32_SYSV_LD_STRUCT_2	PPC_LD_U16
+ #else
+ #define PPC32_SYSV_LD_STRUCT_3	11
+ #define PPC32_SYSV_LD_STRUCT_5	12
+ #define PPC32_SYSV_LD_STRUCT_6	13
+ #define PPC32_SYSV_LD_STRUCT_7	14
++#define PPC32_SYSV_LD_STRUCT_1	15
++#define PPC32_SYSV_LD_STRUCT_2	16
+ #endif
+ 
+ #else /* POWERPC64 */
+--- a/src/powerpc/ffi_sysv.c
++++ b/src/powerpc/ffi_sysv.c
+@@ -960,9 +960,9 @@ ffi_closure_helper_SYSV (ffi_cif *cif,
+ 	switch (size)
+ 	  {
+ 	  case 1:
+-	    return PPC_LD_U8;
++	    return PPC32_SYSV_LD_STRUCT_1;
+ 	  case 2:
+-	    return PPC_LD_U16;
++	    return PPC32_SYSV_LD_STRUCT_2;
+ 	  case 3:
+ 	    return PPC32_SYSV_LD_STRUCT_3;
+ 	  case 4:
+--- a/src/powerpc/ppc_closure.S
++++ b/src/powerpc/ppc_closure.S
+@@ -228,7 +228,15 @@ E PPC32_SYSV_LD_STRUCT_7
+ 	lwz %r3,112+0(%r1)
+ 	lwz %r4,112+4(%r1)
+ 	li %r5,8
+-	nop
++	b .Lstruct567
++
++E PPC32_SYSV_LD_STRUCT_1
++	lbz %r3,112+0(%r1)
++	epilogue
++
++E PPC32_SYSV_LD_STRUCT_2
++	lhz %r3,112+0(%r1)
++	epilogue
+ 
+ .Lstruct567:
+ 	subfic %r6,%r5,32
diff --git a/package/libs/libffi/patches/012-powerpc-add-complex-type-support-for-32-bit-SYSV.patch b/package/libs/libffi/patches/012-powerpc-add-complex-type-support-for-32-bit-SYSV.patch
new file mode 100644
index 0000000..4489e80
--- /dev/null
+++ b/package/libs/libffi/patches/012-powerpc-add-complex-type-support-for-32-bit-SYSV.patch
@@ -0,0 +1,429 @@
+From 5e9f34d6e75fb538ae039bd5117b5d6f24ed30e0 Mon Sep 17 00:00:00 2001
+From: Daniel Golle <daniel@makrotopia.org>
+Date: Tue, 20 Oct 2026 23:08:27 +0000
+Subject: [PATCH] powerpc: add complex type support for 32-bit SYSV
+
+The 32-bit SYSV ABI passes and returns complex values in GPRs, never in
+FPRs, even with hard float.  GCC does not split them for this ABI but
+treats each one as a single item of as many words as it needs, and
+those items follow the same rules as integers of the same size:
+
+  - one word (_Complex char and short) like an int, right-justified;
+  - two words (float and int _Complex) like long long: in an even/odd
+    GPR pair (r3:r4, r5:r6, r7:r8, r9:r10), otherwise 8-byte aligned on
+    the stack, and the remaining GPRs count as used;
+  - more words (double and long long _Complex, four words) in
+    consecutive GPRs with no pair alignment if they all fit, otherwise
+    4-byte aligned on the stack, and every later argument goes to the
+    stack too;
+  - returned in r3, r3:r4 or r3-r6.
+
+All of these already exist for soft-float long double (FFI_TYPE_UINT128)
+and long long, so map complex types onto them by size in a new
+translate_type(), used everywhere translate_float() was.
+
+With a 128-bit long double, long double _Complex takes eight words: it
+goes in r3-r10 when it is the first argument and on the stack otherwise,
+and is returned in r3-r10.  Handle it as an internal FFI_TYPE_UINT256,
+passed like FFI_TYPE_UINT128 with eight words, with a new
+FLAG_RETURNS_256BITS that makes ffi_call_SYSV also store r7-r10, and a
+PPC32_LD_R3R10 closure return entry.  The closure's return value area
+is exactly 32 bytes.
+
+A _Complex char is returned right-justified in r3, so ffi_call uses the
+small struct bounce buffer for it and the closure helper shifts it into
+place.  The ELFv2 handling of that bounce buffer for integer complex
+types is now limited to powerpc64.
+
+ffi_prep_types_sysv() resizes ffi_type_longdouble according to the abi;
+keep ffi_type_complex_longdouble in step with it, as ffi_linux64.c does.
+
+This matches GCC's code generation for 8548 (soft-float) and 464fp
+(hard-float), with 64-bit long double (musl) and with
+-mlong-double-128.
+Assisted-by: LLM
+Signed-off-by: Daniel Golle <daniel@makrotopia.org>
+---
+ src/powerpc/ffi.c         |   2 +-
+ src/powerpc/ffi_powerpc.h |  16 +++--
