diff --git a/package/libs/libffi/patches/019-arm-lay-out-the-arguments-behind-the-hidden-struct-return-pointer.patch b/package/libs/libffi/patches/019-arm-lay-out-the-arguments-behind-the-hidden-struct-return-pointer.patch
new file mode 100644
index 0000000..4f42c70
--- /dev/null
+++ b/package/libs/libffi/patches/019-arm-lay-out-the-arguments-behind-the-hidden-struct-return-pointer.patch
@@ -0,0 +1,55 @@
+From ca494a1fc657acdaf4945e4a7dde7adf1e7ac535 Mon Sep 17 00:00:00 2001
+From: Daniel Golle <daniel@makrotopia.org>
+Date: Wed, 21 Oct 2026 01:24:00 +0000
+Subject: [PATCH] arm: lay out the arguments behind the hidden struct return
+ pointer
+
+A function that returns a struct or complex value of more than 4 bytes
+takes the address of the return value in r0, ahead of its arguments.
+ffi_prep_cif_machdep() accounts for that by adding 4 bytes to the
+argument size computed by ffi_prep_cif_core(), but that size was
+computed without the pointer.  Moving the arguments up by 4 bytes can
+add up to 4 bytes of padding in front of the first 8-byte aligned one,
+which ffi_prep_args_SYSV() then writes past the end of the argument
+area, into the call frame that follows it.
+
+Compute the size again with the pointer in front of the arguments,
+using the same alignment as ffi_prep_args_SYSV().
+
+With soft float, a call returning float _Complex after seven doubles
+and before an int (complex_regs_float) passed garbage for the int and
+returned garbage on mxs (arm926ej-s) and ixp4xx (xscale, big-endian)
+under qemu-user.  The same happens for any struct returned in memory
+whenever the pointer adds such padding.
+
+Fixes: 6fa617dabc3d ("arm: Add argument space for the hidden struct return pointer")
+Assisted-by: LLM
+Signed-off-by: Daniel Golle <daniel@makrotopia.org>
+---
+ src/arm/ffi.c | 14 +++++++++++++-
+ 1 file changed, 13 insertions(+), 1 deletion(-)
+
+--- a/src/arm/ffi.c
++++ b/src/arm/ffi.c
+@@ -309,8 +309,20 @@ ffi_prep_cif_machdep (ffi_cif *cif)
+ 	flags = ARM_TYPE_INT;
+       else
+ 	{
++	  /* The address of the return value goes in r0, ahead of the
++	     arguments, which can then need more padding than cif->bytes
++	     includes.  Lay them out again behind it.  */
++	  unsigned i;
++
+ 	  flags = ARM_TYPE_STRUCT;
+-	  bytes += 4;
++	  bytes = 4;
++	  for (i = 0; i < cif->nargs; i++)
++	    {
++	      ffi_type *ty = cif->arg_types[i];
++
++	      bytes = (size_t) ffi_align (ty, (void *) bytes);
++	      bytes += FFI_ALIGN (ty->size, 4);
++	    }
+ 	}
+       break;
+ 
diff --git a/package/libs/libffi/patches/020-arm-pass-sub-word-complex-arguments-to-big-endian-closures-in-place.patch b/package/libs/libffi/patches/020-arm-pass-sub-word-complex-arguments-to-big-endian-closures-in-place.patch
new file mode 100644
index 0000000..419853f
--- /dev/null
+++ b/package/libs/libffi/patches/020-arm-pass-sub-word-complex-arguments-to-big-endian-closures-in-place.patch
@@ -0,0 +1,54 @@
+From 807644a16854a435bedba7a1b15bdd7c4c2e9655 Mon Sep 17 00:00:00 2001
+From: Daniel Golle <daniel@makrotopia.org>
+Date: Wed, 21 Oct 2026 01:24:08 +0000
+Subject: [PATCH] arm: pass sub-word complex arguments to big-endian closures
+ in place
+
+On big-endian ARM, an integer argument narrower than 4 bytes is in the
+low-order end of its register or stack slot, at offset 4 - size, which
+the closure argument code now takes into account for everything except
+structs.  Complex values are composite types like structs, though, and
+are passed as if loaded from memory with LDR, at offset 0: GCC passes a
+_Complex char in the upper half of r0.
+
+Exclude complex types from the adjustment as well.
+
+complex_int_small failed on ixp4xx (xscale, big-endian) under qemu-user
+when a closure read a _Complex signed char argument.
+
+Fixes: 2b53369681cc ("arm: fix big-endian sub-word argument offsets in closures")
+Assisted-by: LLM
+Signed-off-by: Daniel Golle <daniel@makrotopia.org>
+---
+ src/arm/ffi.c | 6 +++---
+ 1 file changed, 3 insertions(+), 3 deletions(-)
+
+--- a/src/arm/ffi.c
++++ b/src/arm/ffi.c
+@@ -480,7 +480,7 @@ ffi_prep_incoming_args_SYSV (ffi_cif *ci
+ 
+       argp = ffi_align (ty, argp);
+ #ifdef __ARMEB__
+-      if (z < 4 && ty->type != FFI_TYPE_STRUCT)
++      if (z < 4 && ty->type != FFI_TYPE_STRUCT && ty->type != FFI_TYPE_COMPLEX)
+ 	avalue[i] = (void *) (argp + 4 - z);
+       else
+ #endif
+@@ -533,7 +533,7 @@ ffi_prep_incoming_args_VFP (ffi_cif *cif
+ 	    {
+ 	      /* Because we're little endian, this is what it turns into.  */
+ #ifdef __ARMEB__
+-	      if (z < 4 && ty->type != FFI_TYPE_STRUCT)
++	      if (z < 4 && ty->type != FFI_TYPE_STRUCT && ty->type != FFI_TYPE_COMPLEX)
+ 		avalue[i] = (void *) (tregp + 4 - z);
+ 	      else
+ #endif
+@@ -560,7 +560,7 @@ ffi_prep_incoming_args_VFP (ffi_cif *cif
+       stack_used = 1;
+       argp = ffi_align (ty, argp);
+ #ifdef __ARMEB__
+-      if (z < 4 && ty->type != FFI_TYPE_STRUCT)
++      if (z < 4 && ty->type != FFI_TYPE_STRUCT && ty->type != FFI_TYPE_COMPLEX)
+ 	avalue[i] = (void *) (argp + 4 - z);
+       else
+ #endif
diff --git a/package/libs/libffi/patches/021-mips-fix-O32-complex-call-and-closure-returns.patch b/package/libs/libffi/patches/021-mips-fix-O32-complex-call-and-closure-returns.patch
new file mode 100644
index 0000000..174d782
--- /dev/null
+++ b/package/libs/libffi/patches/021-mips-fix-O32-complex-call-and-closure-returns.patch
@@ -0,0 +1,188 @@
+From 8a1db7350d1037671747fbf135204c8976fb60fd Mon Sep 17 00:00:00 2001
+From: Anthony Green <green@moxielogic.com>
+Date: Wed, 28 Oct 2026 06:23:32 -0400
+Subject: [PATCH] mips: fix O32 complex call and closure returns
+
+Handle all integer-complex sizes in the O32 call path and return soft-float complex values through the ABI-defined GPR set. Restore hard-float closure results from the FP save area, preserve the argument flags, and pass the complex result size back to assembly explicitly.
+
+Reported-by: Daniel Golle <daniel@makrotopia.org>
+---
+ src/mips/ffi.c | 50 ++++++++++++++++++++++++++++++++++++++++++++------
+ src/mips/o32.S | 45 ++++++++++++++++++++++++++++++++++++++++-----
+ 2 files changed, 84 insertions(+), 11 deletions(-)
+
+--- a/src/mips/ffi.c
++++ b/src/mips/ffi.c
+@@ -402,7 +402,7 @@ static ffi_status ffi_prep_cif_machdep_i
+    * does not have special handling for floating point args.
+    */
+ 
+-  if (cif->rtype->type != FFI_TYPE_STRUCT && cif->rtype->type != FFI_TYPE_COMPLEX && cif->abi == FFI_O32)
++  if (cif->rtype->type != FFI_TYPE_STRUCT && cif->abi == FFI_O32)
+     {
+       if (cif->nargs > 0 && cif->nargs == nfixedargs)
+ 	{
+@@ -455,6 +455,24 @@ static ffi_status ffi_prep_cif_machdep_i
+           cif->flags += FFI_TYPE_UINT64 << (FFI_FLAG_BITS * 2);
+           break;
+       
++        case FFI_TYPE_COMPLEX:
++          /* Complex values are returned in GPRs like integer complex
++             values of the same size.  */
++          cif->flags += FFI_TYPE_COMPLEX << (FFI_FLAG_BITS * 2);
++          switch (cif->rtype->elements[0]->type)
++            {
++            case FFI_TYPE_FLOAT:
++              cif->flags += FFI_TYPE_UINT32 << (FFI_FLAG_BITS * 4);
++              break;
++            case FFI_TYPE_DOUBLE:
++              cif->flags += FFI_TYPE_UINT64 << (FFI_FLAG_BITS * 4);
++              break;
++            default:
++              cif->flags += cif->rtype->elements[0]->type << (FFI_FLAG_BITS * 4);
++              break;
++            }
++          break;
++
+         case FFI_TYPE_FLOAT:
+         default:
+           cif->flags += FFI_TYPE_INT << (FFI_FLAG_BITS * 2);
+@@ -978,11 +996,19 @@ ffi_closure_mips_inner_O32 (ffi_cif *cif
+       argn = 1;
+       seen_int = 1;
+     }
+-  if ((cif->flags >> (FFI_FLAG_BITS * 2)) == FFI_TYPE_COMPLEX)
++  if (cif->rtype->type == FFI_TYPE_COMPLEX
++      && (cif->rtype->elements[0]->type == FFI_TYPE_FLOAT
++          || cif->rtype->elements[0]->type == FFI_TYPE_DOUBLE
++          || cif->rtype->elements[0]->type == FFI_TYPE_LONGDOUBLE))
+     {
+       rvalue = fpr;
+-      argn = 1;
+     }
++  /* With soft float, complex values are returned in up to four GPRs,
++     which does not fit into the space for v0 and v1.  ffi_closure_O32
++     does not use the space for the FP argument registers in that case,
++     so return the value there.  */
++  if (cif->abi == FFI_O32_SOFT_FLOAT && cif->rtype->type == FFI_TYPE_COMPLEX)
++    rvalue = fpr;
+ 
+   i = 0;
+   avn = cif->nargs;
+@@ -1041,6 +1067,15 @@ ffi_closure_mips_inner_O32 (ffi_cif *cif
+   /* Invoke the closure. */
+   fun(cif, rvalue, avaluep, user_data);
+ 
++  if (cif->rtype->type == FFI_TYPE_COMPLEX && cif->rtype->size == 2)
++    {
++      /* A _Complex char is returned right-justified in v0.  */
++      UINT16 value;
++
++      memcpy (&value, rvalue, sizeof (value));
++      *(UINT32 *) rvalue = value;
++    }
++
+   if (cif->abi == FFI_O32_SOFT_FLOAT)
+     {
+       switch (cif->rtype->type)
+@@ -1049,15 +1084,18 @@ ffi_closure_mips_inner_O32 (ffi_cif *cif
+           return FFI_TYPE_INT;
+         case FFI_TYPE_DOUBLE:
+           return FFI_TYPE_UINT64;
++        case FFI_TYPE_COMPLEX:
++          return (FFI_TYPE_COMPLEX
++                  | (cif->rtype->size << (FFI_FLAG_BITS * 2)));
+         default:
+           return cif->rtype->type;
+         }
+     }
+   else
+     {
+-      if (cif->rtype->type == FFI_TYPE_COMPLEX) {
+-          __asm__ volatile ("move $v1, %0" : : "r"(cif->rtype->size));
+-      }
++      if (cif->rtype->type == FFI_TYPE_COMPLEX)
++        return (FFI_TYPE_COMPLEX
++                | (cif->rtype->size << (FFI_FLAG_BITS * 2)));
+       return cif->rtype->type;
+     }
+ }
+--- a/src/mips/o32.S
++++ b/src/mips/o32.S
+@@ -224,8 +224,25 @@ retcomplex:
+ 	b	epilogue
+ 
+ 5:
++	# Integer complex values: a _Complex char is returned right-justified
++	# in v0, a _Complex short in v0, a _Complex int in v0/v1 and a
++	# _Complex long long in v0/v1/a0/a1.
++	slti	t3, t1, FFI_TYPE_UINT16
++	bnez	t3, 6f
++	slti	t3, t1, FFI_TYPE_UINT32
++	bnez	t3, 7f
+ 	REG_S	v1, 4(t0)
+ 	REG_S	v0, 0(t0)
++	slti	t3, t1, FFI_TYPE_UINT64
++	bnez	t3, epilogue
++	REG_S	a1, 12(t0)
++	REG_S	a0, 8(t0)
++	b	epilogue
++6:
++	sh	v0, 0(t0)
++	b	epilogue
++7:
++	REG_S	v0, 0(t0)
+ 	b	epilogue
+ 
+ noretval:	
+@@ -408,11 +425,13 @@ $do_closure:
+ 
+ 	# Load the return value into the appropriate register.
+ 	move	$8, $2
++	SRL	$3, $8, (FFI_FLAG_BITS * 2)
++	and	$8, ((1 << (FFI_FLAG_BITS * 2)) - 1)
+ 	li	$9, FFI_TYPE_VOID
+ 	beq	$8, $9, closure_done
+ 
+ 	li	$13, 1		# FFI_O32
+-	bne	$16, $13, 1f	# Skip fp restore if FFI_O32_SOFT_FLOAT
++	bne	$16, $13, 2f	# Skip fp restore if FFI_O32_SOFT_FLOAT
+ 
+ #ifndef __mips_soft_float
+ 	li	$9, FFI_TYPE_FLOAT
+@@ -427,15 +446,31 @@ $do_closure:
+ 	bne     $8, $9, 1f
+ 
+ 	li      $9, 8
+-	l.s	$f0, V0_OFF2($fp)
+-	l.s	$f2, V1_OFF2($fp)
++	REG_L	$2, FA_0_0_OFF2($fp)
++	mtc1	$2, $f0
++	REG_L	$2, FA_0_1_OFF2($fp)
++	mtc1	$2, $f2
+ 	beq     $3, $9, closure_done
+ 
+ 	li      $9, 16
+-	l.d	$f0, V0_OFF2($fp)
+-	l.d	$f2, (V0_OFF2+8)($fp)
++	l.d	$f0, FA_0_0_OFF2($fp)
++	l.d	$f2, FA_1_0_OFF2($fp)
+ 	beq     $3, $9, closure_done
+ #endif
++	b	1f
++
++2:
++	# FFI_O32_SOFT_FLOAT returns complex values in up to four GPRs.
++	# ffi_closure_mips_inner_O32 stored them in the space for the
++	# FP argument registers.
++	li	$9, FFI_TYPE_COMPLEX
++	bne	$8, $9, 1f
++	REG_L	$2, FA_0_0_OFF2($fp)
++	REG_L	$3, FA_0_1_OFF2($fp)
++	REG_L	$4, FA_1_0_OFF2($fp)
++	REG_L	$5, FA_1_1_OFF2($fp)
++	b	closure_done
++
+ 1:	
+ 	REG_L	$3, V1_OFF2($fp)
+ 	REG_L	$2, V0_OFF2($fp)
diff --git a/package/libs/libffi/patches/022-mips-bound-small-complex-return-stores.patch b/package/libs/libffi/patches/022-mips-bound-small-complex-return-stores.patch
new file mode 100644
index 0000000..6793a4f
--- /dev/null
+++ b/package/libs/libffi/patches/022-mips-bound-small-complex-return-stores.patch
@@ -0,0 +1,48 @@
+From 0762e0daeea915d1890c93c2dde69efc85ee2c2f Mon Sep 17 00:00:00 2001
+From: Anthony Green <green@moxielogic.com>
+Date: Wed, 28 Oct 2026 07:14:59 -0400
+Subject: [PATCH] mips: bound small complex return stores
+
+The N32/N64 assembly writes complex GPR returns in 8-byte chunks. Bounce values smaller than 16 bytes through an aligned temporary buffer so callers' result objects are not overrun, and account for big-endian right justification. Do the matching right justification for closure returns smaller than one register.\n\nReported-by: Daniel Golle <daniel@makrotopia.org>
+---
+ src/mips/ffi.c | 22 ++++++++++++++++++++++
+ 1 file changed, 22 insertions(+)
+
+--- a/src/mips/ffi.c
++++ b/src/mips/ffi.c
+@@ -816,6 +816,18 @@ void ffi_call_int(ffi_cif *cif, void (*f
+             rvalue_copy = alloca(16);
+             copy_rvalue = 1;
+           }
++	else if (cif->rtype->type == FFI_TYPE_COMPLEX && cif->rtype->size < 16)
++	  {
++	    /* The assembly stores complex GPR returns in 8-byte chunks.
++	       Bounce them through a suitably sized and aligned buffer so a
++	       smaller user result cannot be overrun.  */
++	    rvalue_copy = alloca (16);
++	    copy_rvalue = 1;
++#if defined(__MIPSEB__) || defined(_MIPSEB)
++	    if (cif->rtype->size < 8)
++	      copy_offset = 8 - cif->rtype->size;
++#endif
++	  }
+ 	else if (cif->rtype->type == FFI_TYPE_FLOAT
+ 		 && (cif->abi == FFI_N64_SOFT_FLOAT
+ 		     || cif->abi == FFI_N32_SOFT_FLOAT))
+@@ -1320,6 +1332,16 @@ ffi_closure_mips_inner_N32 (ffi_cif *cif
+ #endif
+       )
+     *(ffi_arg *) rvalue = (SINT32) *(UINT32 *) rvalue;
++
++  /* Complex values smaller than 8 bytes are returned right-justified in
++     v0, which ffi_closure_N32 loads as a whole.  */
++  if (cif->rtype->type == FFI_TYPE_COMPLEX && cif->rtype->size < 8)
++    {
++      size_t size = cif->rtype->size;
++
++      memmove ((char *) rvalue + 8 - size, rvalue, size);
++      memset (rvalue, 0, 8 - size);
++    }
+ #endif
+ 
+   return cif->flags >> (FFI_FLAG_BITS * 8);
