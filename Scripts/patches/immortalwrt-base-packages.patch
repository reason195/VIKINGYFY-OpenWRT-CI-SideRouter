diff --git a/package/network/services/dnsmasq/patches/210-ubus-free-a-lost-connection-only-from-check_ubus_lis.patch b/package/network/services/dnsmasq/patches/210-ubus-free-a-lost-connection-only-from-check_ubus_lis.patch
new file mode 100644
index 0000000..c4d46c5
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/210-ubus-free-a-lost-connection-only-from-check_ubus_lis.patch
@@ -0,0 +1,65 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sat, 24 Oct 2026 06:03:04 +0200
+Subject: [PATCH] ubus: free a lost connection only from check_ubus_listeners()
+
+When ubusd goes away, ubus_disconnect_cb() runs from within libubus.
+If ubus_reconnect() fails, it frees the context with ubus_destroy().
+check_ubus_listeners() reads ubus->sock.fd right after
+ubus_handle_event() returns, from the freed context:
+
+  ERROR: AddressSanitizer: heap-use-after-free
+    #0 check_ubus_listeners src/ubus.c
+    #1 main src/dnsmasq.c
+  freed by thread T0 here:
+    #1 ubus_destroy src/ubus.c
+    #2 ubus_disconnect_cb src/ubus.c
+
+The callback also runs inside ubus_complete_request(), which reads the
+context after the callback returns. That wait happens in
+ubus_dns_notify() and in the connmark allowlist notify with a timeout.
+
+Let the callback leave the context alone. check_ubus_listeners() hands
+every poll event of the socket to libubus and frees the context once
+libubus marked it lost; the main loop then connects again through
+ubus_init(). This also stops a stale POLLHUP from closing a connection
+that ubus_reconnect() just opened on the same fd number.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+ src/ubus.c | 16 +++++-----------
+ 1 file changed, 5 insertions(+), 11 deletions(-)
+
+--- a/src/ubus.c
++++ b/src/ubus.c
+@@ -100,15 +100,9 @@ static void ubus_destroy(struct ubus_con
+ 
+ static void ubus_disconnect_cb(struct ubus_context *ubus)
+ {
+-  int ret;
+-
+-  ret = ubus_reconnect(ubus, NULL);
+-  if (ret)
+-    {
+-      my_syslog(LOG_ERR, _("Cannot reconnect to UBus: %s"), ubus_strerror(ret));
+-
+-      ubus_destroy(ubus);
+-    }
++  /* A waiting ubus_complete_request() uses the context after this
++     callback returns, so check_ubus_listeners() frees it. */
++  (void)ubus;
+ }
+ 
+ char *ubus_init()
+@@ -182,10 +176,10 @@ void check_ubus_listeners()
+   
+   error_logged = 0;
+ 
+-  if (poll_check(ubus->sock.fd, POLLIN))
++  if (poll_check(ubus->sock.fd, POLLIN | POLLHUP | POLLERR))
+     ubus_handle_event(ubus);
+   
+-  if (poll_check(ubus->sock.fd, POLLHUP | POLLERR))
++  if (ubus->sock.eof)
+     {
+       my_syslog(LOG_INFO, _("Disconnecting from UBus"));
+ 
diff --git a/package/network/services/dnsmasq/patches/220-ubus-wake-the-main-loop-while-waiting-to-connect-aga.patch b/package/network/services/dnsmasq/patches/220-ubus-wake-the-main-loop-while-waiting-to-connect-aga.patch
new file mode 100644
index 0000000..a5ce086
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/220-ubus-wake-the-main-loop-while-waiting-to-connect-aga.patch
@@ -0,0 +1,31 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sat, 24 Oct 2026 06:03:04 +0200
+Subject: [PATCH] ubus: wake the main loop while waiting to connect again
+
+After a lost UBus connection, the main loop calls ubus_init() again
+only when poll() returns. Without DNS or DHCP traffic nothing wakes
+poll(), so dnsmasq stays off the bus after a ubusd restart.
+
+Wake every second while the UBus connection is missing, as for a
+missing DBus connection.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+ src/dnsmasq.c | 6 ++++++
+ 1 file changed, 6 insertions(+)
+
+--- a/src/dnsmasq.c
++++ b/src/dnsmasq.c
+@@ -1118,6 +1118,12 @@ int main (int argc, char **argv)
+ 	       (timeout == -1 || timeout > 1000))
+ 	timeout = 1000;
+       
++#ifdef HAVE_UBUS
++      if (option_bool(OPT_UBUS) && !daemon->ubus &&
++	  (timeout == -1 || timeout > 1000))
++	timeout = 1000;
++#endif
++
+       if (daemon->port != 0)
+ 	set_dns_listeners();
+       
diff --git a/package/network/services/dnsmasq/patches/230-Quieten-the-PID-file-chown-failure-when-it-is-harmle.patch b/package/network/services/dnsmasq/patches/230-Quieten-the-PID-file-chown-failure-when-it-is-harmle.patch
new file mode 100644
index 0000000..e31f47a
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/230-Quieten-the-PID-file-chown-failure-when-it-is-harmle.patch
@@ -0,0 +1,58 @@
+From e04c3fff5b17e00504f2ea69acd7d829f058ddc4 Mon Sep 17 00:00:00 2001
+From: Daniel Golle <daniel@makrotopia.org>
+Date: Tue, 3 Nov 2026 20:38:29 +0000
+Subject: [PATCH] Quieten the PID file chown failure when it is harmless
+
+Without CAP_CHOWN, dnsmasq logs that the chown of the PID file failed
+on every start. The file then stays owned by root, which only matters
+if the unprivileged daemon can no longer remove it on exit, and that
+depends on the directory. OpenWrt runs dnsmasq in a jail without
+CAP_CHOWN and a root:dnsmasq 0775 directory for the PID file.
+
+Report the failure only when, after dropping root, dnsmasq cannot
+write to the directory, or the directory is sticky and not its own.
+
+Signed-off-by: Daniel Golle <daniel@makrotopia.org>
+---
+ src/dnsmasq.c | 23 ++++++++++++++++++++++-
+ 1 file changed, 22 insertions(+), 1 deletion(-)
+
+--- a/src/dnsmasq.c
++++ b/src/dnsmasq.c
+@@ -41,6 +41,27 @@ static void fatal_event(struct event_des
+ static int read_event(int fd, struct event_desc *evp, char **msg);
+ static void poll_resolv(int force, int do_reload, time_t now);
+ 
++static int runfile_removable(void)
++{
++  char *dir, *slash;
++  struct stat st;
++  int ret;
++
++  dir = safe_malloc(strlen(daemon->runfile) + 2);
++  strcpy(dir, daemon->runfile);
++
++  if ((slash = strrchr(dir, '/')))
++    slash[slash == dir] = 0;
++  else
++    strcpy(dir, ".");
++
++  ret = access(dir, W_OK | X_OK) == 0 && stat(dir, &st) == 0 &&
++    (!(st.st_mode & S_ISVTX) || st.st_uid == getuid());
++
++  free(dir);
++  return ret;
++}
++
+ int main (int argc, char **argv)
+ {
+   time_t now;
+@@ -883,7 +904,7 @@ int main (int argc, char **argv)
+   
+   my_syslog(LOG_INFO, _("compile time options: %s"), compile_opts);
+ 
+-  if (chown_warn != 0)
++  if (chown_warn != 0 && !runfile_removable())
+     {
+ #if defined(HAVE_LINUX_NETWORK)
+       if (chown_warn == EPERM && !have_cap_chown)
