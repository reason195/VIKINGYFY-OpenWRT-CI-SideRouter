diff --git a/package/network/services/dnsmasq/patches/008-Fix-DNS-name-buffer-overflow.patch b/package/network/services/dnsmasq/patches/008-Fix-DNS-name-buffer-overflow.patch
new file mode 100644
index 0000000..8500b8c
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/008-Fix-DNS-name-buffer-overflow.patch
@@ -0,0 +1,84 @@
+From 145abca7f62a7744fb9aa742ac71e1c10af4cda7 Mon Sep 17 00:00:00 2001
+From: Simon Kelley <simon@thekelleys.org.uk>
+Date: Sat, 17 Oct 2026 01:05:16 +0100
+Subject: [PATCH] Fix DNS name buffer overflow.
+
+There are a couple of instances in the DNSSEC validation code where
+the code steps along a DNS name to remove some number if left-hand
+labels and replace them with * to make a wildcard. The name then
+gets passed to to_wire() to translate it in-place to the wire format.
+
+If external parameters dictate that all the labels are removed, and the name
+is of exactly the maximum size, then this causes to_wire() to overwrite the
+buffer by one byte.
+
+Having created the wildcard, move it to the start of the buffer to avoid
+this problem.
+
+Thanks to Lucas Celant <lcelant@redhat.com> for spotting this.
+
+CVE-2026-93011 may apply.
+---
+ src/dnssec.c | 21 ++++++++++++---------
+ 1 file changed, 12 insertions(+), 9 deletions(-)
+
+--- a/src/dnssec.c
++++ b/src/dnssec.c
+@@ -486,7 +486,6 @@ static int validate_rrset(time_t now, st
+       int i, wire_len, sig_len;
+       const struct nettle_hash *hash;
+       void *ctx;
+-      char *name_start;
+       u32 nsigttl, ttl, orig_ttl;
+ 
+       failflags &= ~DNSSEC_FAIL_NOSIG;
+@@ -576,13 +575,13 @@ static int validate_rrset(time_t now, st
+ 	  if (!extract_name(header, plen, &p, name, EXTR_NAME_EXTRACT, 10)) 
+ 	    return STAT_BOGUS;
+ 
+-	  name_start = name;
+-	  
+ 	  /* if more labels than in RRsig name, hash *.<no labels in rrsig labels field>  4035 5.3.2 */
+ 	  /* If the name is already the wildcard, we're not going to change it. */
+ 	  if (labels < name_labels &&
+-	      !(name_labels - labels == 1 && name_start[0] == '*' && name_start[1] == '.'))
++	      !(name_labels - labels == 1 && name[0] == '*' && name[1] == '.'))
+ 	    {
++	      char *name_start = name;
++
+ 	      for (j = name_labels - labels; j != 0; j--)
+ 		{
+ 		  while (*name_start != '.' && *name_start != 0)
+@@ -595,11 +594,13 @@ static int validate_rrset(time_t now, st
+ 		*wildcard_offset_out = name_start - name + 1;
+ 	      
+ 	      name_start--;
+-	      *name_start = '*';	      
++	      *name_start = '*';
++	      /* move our name to the start of the buffer to avoid pathalogical cases over-running the end in to_wire(). */
++	      memmove(name, name_start, strlen(name_start) + 1);	      
+ 	    }
+-	  
+-	  wire_len = to_wire(name_start);
+-	  hash->update(ctx, (unsigned int)wire_len, (unsigned char *)name_start);
++
++	  wire_len = to_wire(name);
++	  hash->update(ctx, (unsigned int)wire_len, (unsigned char *)name);
+ 	  hash->update(ctx, 4, p); /* class and type */
+ 	  hash->update(ctx, 4, (unsigned char *)&nsigttl);
+ 
+@@ -1687,11 +1688,13 @@ static int prove_non_existence_nsec3(str
+       
+       wildcard--;
+       *wildcard = '*';
++      /* move our name to the start of the buffer to avoid pathalogical cases over-running the end in to_wire(). */
++      memmove(name, wildcard, strlen(wildcard) + 1);
+       
+       if (dec_counter(validate_counter, NULL))
+ 	return DNSSEC_FAIL_WORK;
+       
+-      if ((digest_len = hash_name(wildcard, &digest, hash, salt, salt_len, iterations)) == 0)
++      if ((digest_len = hash_name(name, &digest, hash, salt, salt_len, iterations)) == 0)
+ 	return DNSSEC_FAIL_NONSEC;
+       
+       if (!check_nsec3_coverage(header, plen, digest_len, digest, type, workspace1, workspace2, nsecs, nsec_count, NULL, 1))
diff --git a/package/network/services/dnsmasq/patches/009-Fix-OOB-heap-write-in-blockdata_read.patch b/package/network/services/dnsmasq/patches/009-Fix-OOB-heap-write-in-blockdata_read.patch
new file mode 100644
index 0000000..8089b55
--- /dev/null
+++ b/package/network/services/dnsmasq/patches/009-Fix-OOB-heap-write-in-blockdata_read.patch
@@ -0,0 +1,157 @@
+From 738c0499881fdd046f4793ec99fdc945298cd152 Mon Sep 17 00:00:00 2001
+From: Simon Kelley <simon@thekelleys.org.uk>
+Date: Tue, 20 Oct 2026 23:19:11 +0100
+Subject: [PATCH] Fix OOB heap write in blockdata_read()
+
+A flaw in the blockdata_read() function allows an attacker to overflow
+heap buffers. If memory allocation fails whilst reading data from
+an IPC pipe, some data is left unread in the pipe. This has the effect of
+desynchronising further reads from the pipe and allows an attacker
+to overflow a heap buffer.
+
+Note that the attack depends on running the dnsmasq process out of memory
+so that calls to malloc() begin to fail. This is difficult to do on
+most platforms, unless a small ulimit is set on the size of the
+dnsmasq process. This makes practical attacks somewhat difficult.
+
+Thanks to Michel Belleau for finding and characterising this vulnerability.
+---
+ src/blockdata.c | 71 +++++++++++++++++++++++++++++++++----------------
+ src/cache.c     | 15 ++++++++---
+ 2 files changed, 60 insertions(+), 26 deletions(-)
+
+--- a/src/blockdata.c
++++ b/src/blockdata.c
+@@ -16,7 +16,9 @@
+ 
+ #include "dnsmasq.h"
+ 
+-static struct blockdata *keyblock_free;
++static struct blockdata *new_block(void);
++
++static struct blockdata *keyblock_free, *fallback;
+ static unsigned int blockdata_count, blockdata_hwm, blockdata_alloced;
+ 
+ static void add_blocks(int n)
+@@ -48,7 +50,11 @@ void blockdata_init(void)
+   /* Note that daemon->cachesize is enforced to have non-zero size if OPT_DNSSEC_VALID is set */  
+   if (option_bool(OPT_DNSSEC_VALID))
+     add_blocks(daemon->cachesize);
+-}
++
++  /* make sure we have one block to fall back on. */
++  if (!(fallback = new_block()))
++    die(_("Blockdata init: no memory"), NULL, EC_MISC);
++ }
+ 
+ void blockdata_report(void)
+ {
+@@ -84,36 +90,47 @@ static struct blockdata *blockdata_alloc
+   struct blockdata *block, *ret = NULL;
+   struct blockdata **prev = &ret;
+   size_t blen;
+-
+-  do
++  int fail;
++  
++  for (fail = 0; len != 0; len -= blen)
+     {
+-      if (!(block = new_block()))
+-	{
+-	  /* failed to alloc, free partial chain */
+-	  blockdata_free(ret);
+-	  return NULL;
+-	}
++       blen = len > KEYBLOCK_LEN ? KEYBLOCK_LEN : len;
+ 
+-      if ((blen = len > KEYBLOCK_LEN ? KEYBLOCK_LEN : len) > 0)
++       if (!fail)
+ 	{
+-	  if (data)
++	  if ((block = new_block()))
+ 	    {
+-	      memcpy(block->key, data, blen);
+-	      data += blen;
++	      *prev = block;
++	      prev = &block->next;
+ 	    }
+-	  else if (!read_write(fd, block->key, blen, RW_READ))
++	  else
+ 	    {
+-	      /* failed read free partial chain */
+-	      blockdata_free(ret);
+-	      return NULL;
++	      /* Failed to alloc, use the pre-allocated fall-back. 
++		 This allows us to always read the specified amount of data from the fd. */
++	      fail = 1;
++	      block = fallback;
+ 	    }
+ 	}
+-      
+-      len -= blen;
+-      *prev = block;
+-      prev = &block->next;
+-    } while (len != 0);
+-  
++
++       if (data)
++	 {
++	   memcpy(block->key, data, blen);
++	   data += blen;
++	 }
++       else if (!read_write(fd, block->key, blen, RW_READ))
++	 {
++	   fail = 1;
++	   break;
++	 }
++    }
++  
++  if (fail)
++    {
++      /* failed, free partial chain */
++      blockdata_free(ret);
++      return NULL;
++    }
++
+   return ret;
+ }
+ 
+@@ -235,6 +252,14 @@ void blockdata_write(struct blockdata *b
+     }
+ }
+ 
++/* NOTE: this can fail (NULL return) for three possible reasons.
++   1) len == 0 - trivial
++   2) end of stream. 
++   3) malloc failure when allocating blocks.
++
++   Unless EOF is encountered, len octets will always be read from the stream,
++   even in memory allocation fails.
++*/
+ struct blockdata *blockdata_read(int fd, size_t len)
+ {
+   return blockdata_alloc_real(fd, NULL, len);
+--- a/src/cache.c
++++ b/src/cache.c
+@@ -1039,9 +1039,18 @@ int cache_recv_insert(time_t now, int fd
+ 		unsigned short class = C_IN;
+ 		struct blockdata *block = NULL;
+ 
