+From 463ae02e66f4ea6be45a9e2bb2f646fa3da7d62a Mon Sep 17 00:00:00 2001
+From: Daniel Golle <daniel@makrotopia.org>
+Date: Wed, 21 Oct 2026 01:24:14 +0000
+Subject: [PATCH] testsuite: check return values of structs with one or two
+ floating-point fields
+
+Many ABIs return a struct of one or two float or double fields
+differently from other small structs, in floating-point registers, or
+with soft float in other GPRs than an integer struct of the same size.
+Only a few of these combinations are covered, mostly through ffi_call.
+
+Add cls_struct_fp_return, which returns structs of float, double, two
+floats, two doubles, float and double, and double and float, both
+through ffi_call and through closures.
+Assisted-by: LLM
+Signed-off-by: Daniel Golle <daniel@makrotopia.org>
+---
+ testsuite/Makefile.am                         |  2 +-
+ .../libffi.closures/cls_struct_fp_return.c    | 99 +++++++++++++++++++
+ 2 files changed, 100 insertions(+), 1 deletion(-)
+ create mode 100644 testsuite/libffi.closures/cls_struct_fp_return.c
+
+--- a/testsuite/Makefile.am
++++ b/testsuite/Makefile.am
+@@ -64,7 +64,7 @@ EXTRA_DIST = config/default.exp emscript
+ 	libffi.closures/cls_multi_sshortchar.c libffi.closures/cls_multi_uchar.c libffi.closures/cls_multi_ushort.c \
+ 	libffi.closures/cls_multi_ushortchar.c libffi.closures/cls_pointer.c libffi.closures/cls_pointer_stack.c \
+ 	libffi.closures/cls_schar.c libffi.closures/cls_sint.c libffi.closures/cls_sshort.c \
+-	libffi.closures/cls_struct_va1.c libffi.closures/cls_uchar.c libffi.closures/cls_uint.c \
++	libffi.closures/cls_struct_fp_return.c libffi.closures/cls_struct_va1.c libffi.closures/cls_uchar.c libffi.closures/cls_uint.c \
+ 	libffi.closures/cls_uint_va.c libffi.closures/cls_ulong_va.c libffi.closures/cls_ulonglong.c \
+ 	libffi.closures/cls_ushort.c libffi.closures/err_bad_abi.c libffi.closures/ffitest.h \
+ 	libffi.closures/huge_struct.c libffi.closures/nested_struct.c libffi.closures/nested_struct1.c \
+--- /dev/null
++++ b/testsuite/libffi.closures/cls_struct_fp_return.c
+@@ -0,0 +1,99 @@
++/* Area:	ffi_call, closure_call
++   Purpose:	Check return values of structs with one or two floating-point
++		fields.
++   Limitations:	none.
++   PR:		none.  */
++
++/* { dg-do run } */
++
++#include "ffitest.h"
++
++/* Several ABIs return these structs in floating-point registers, or with
++   soft float in pairs of GPRs that differ from those used for other small
++   structs, so they need their own return paths in ffi_call and in
++   closures.  */
++
++typedef struct { float a; } s_f;
++typedef struct { double a; } s_d;
++typedef struct { float a; float b; } s_ff;
++typedef struct { double a; double b; } s_dd;
++typedef struct { float a; double b; } s_fd;
++typedef struct { double a; float b; } s_df;
++
++#define DEFINE(name, eq, ...)						\
++static name ABI_ATTR							\
++fn_##name (int k)							\
++{									\
++  name r = { __VA_ARGS__ };						\
++  return r;								\
++}									\
++									\
++static void								\
++cls_##name (ffi_cif *cif __UNUSED__, void *resp, void **argv,		\
++	    void *userdata __UNUSED__)					\
++{									\
++  *(name *) resp = fn_##name (*(int *) argv[0]);			\
++}									\
++									\
++static int								\
++eq_##name (name x, name y)						\
++{									\
++  return eq;								\
++}
++
++#define EQ1 (x.a == y.a)
++#define EQ2 (x.a == y.a && x.b == y.b)
++
++DEFINE (s_f, EQ1, 1.5f * k)
++DEFINE (s_d, EQ1, 2.5 * k)
++DEFINE (s_ff, EQ2, 1.5f * k, -0.25f * k)
++DEFINE (s_dd, EQ2, 2.5 * k, -0.75 * k)
++DEFINE (s_fd, EQ2, 1.5f * k, -0.75 * k)
++DEFINE (s_df, EQ2, 2.5 * k, -0.25f * k)
++
++#define CHECK_ONE(name, type1, type2)					\
++  do {									\
++    ffi_type *elements[3] = { type1, type2, NULL };			\
++    ffi_type type;							\
++    ffi_type *args[1] = { &ffi_type_sint };				\
++    void *values[1] = { &k };						\
++    ffi_cif cif;							\
++    ffi_closure *pcl;							\
++    void *code;								\
++    name want = fn_##name (k), got;					\
++									\
++    type.size = 0;							\
++    type.alignment = 0;							\
++    type.type = FFI_TYPE_STRUCT;					\
++    type.elements = elements;						\
++    CHECK (ffi_prep_cif (&cif, ABI_NUM, 1, &type, args) == FFI_OK);	\
++									\
++    memset (&got, 0, sizeof (got));					\
++    ffi_call (&cif, FFI_FN (fn_##name), &got, values);			\
++    CHECK (eq_##name (got, want));					\
++									\
++    pcl = ffi_closure_alloc (sizeof (ffi_closure), &code);		\
++    CHECK (pcl != NULL);						\
++    CHECK (ffi_prep_closure_loc (pcl, &cif, cls_##name, NULL, code)	\
++	   == FFI_OK);							\
++    memset (&got, 0, sizeof (got));					\
++    got = ((name (ABI_ATTR *)(int)) code) (k);				\
++    CHECK (eq_##name (got, want));					\
++    ffi_closure_free (pcl);						\
++    printf ("%s: ok\n", #name);						\
++  } while (0)
++
++int
++main (void)
++{
++  int k = 3;
++
++  CHECK_ONE (s_f, &ffi_type_float, NULL);
++  CHECK_ONE (s_d, &ffi_type_double, NULL);
++  CHECK_ONE (s_ff, &ffi_type_float, &ffi_type_float);
++  CHECK_ONE (s_dd, &ffi_type_double, &ffi_type_double);
++  CHECK_ONE (s_fd, &ffi_type_float, &ffi_type_double);
++  CHECK_ONE (s_df, &ffi_type_double, &ffi_type_float);
++
++  exit (0);
++}
diff --git a/package/libs/libffi/patches/015-mips-fix-N32-N64-soft-float-returns-of-floating-point-structs.patch b/package/libs/libffi/patches/015-mips-fix-N32-N64-soft-float-returns-of-floating-point-structs.patch
new file mode 100644
index 0000000..35090c4
--- /dev/null
+++ b/package/libs/libffi/patches/015-mips-fix-N32-N64-soft-float-returns-of-floating-point-structs.patch
@@ -0,0 +1,113 @@
+From 4686b25129cb5ee205b28329daa5d4a34ecbb8b1 Mon Sep 17 00:00:00 2001
+From: Daniel Golle <daniel@makrotopia.org>
+Date: Wed, 21 Oct 2026 01:24:14 +0000
+Subject: [PATCH] mips: fix N32/N64 soft-float returns of floating-point
+ structs
+
+With soft float, GCC returns a struct of one or two float or double
+fields with the first field in v0 and the second in a0, each like a
+scalar of its type, i.e. a float in the low 32 bits.  libffi got this
+partly wrong:
+
+  - ffi_call_N32 took the second field of a struct of two floats or of
+    a double and a float from v1; 2e825e219fa0 ("MIPS: fix some N32
+    test failure (#701)") had changed the other two cases to a0.
+  - ffi_closure_N32 had no soft-float struct cases at all and returned
+    these structs like any small struct, as the first 16 bytes of the
+    return value in v0 and v1.  That puts the second field in the wrong
+    register, and on big-endian a single float in the upper half of v0.
+
+Store the second field from a0 in ffi_call_N32, and return soft-float
+structs of one or two floating-point fields from the closure in v0 and
+a0.  Like the soft-float cases in ffi_call_N32, the new closure cases
+are outside the hard-float #ifdef, so a library built for hard float
+also handles cifs for the soft-float ABIs.
+
+This fixes cls_struct_fp_return on malta (mips64r2, both endians) and
+octeon (octeon+), n64 soft-float, under qemu-user, and the remaining
+failure of libffi.bhaible/test-callback on big-endian, a closure
+returning struct { float x; }.  This code predates the git history.
+Assisted-by: LLM
+Signed-off-by: Daniel Golle <daniel@makrotopia.org>
+---
+ src/mips/n32.S | 45 +++++++++++++++++++++++++++++++++++++++++----
+ 1 file changed, 41 insertions(+), 4 deletions(-)
+
+--- a/src/mips/n32.S
++++ b/src/mips/n32.S
+@@ -396,7 +396,7 @@ retstruct_f_f_soft:
+ 	jal	t9
+ 	REG_L	t4, 4*FFI_SIZEOF_ARG($fp)
+ 	sw	v0, 0(t4)
+-	sw	v1, 4(t4)
++	sw	a0, 4(t4)
+ 	b	epilogue
+ 	
+ retstruct_d_f_soft:	
+@@ -404,7 +404,7 @@ retstruct_d_f_soft:
+ 	jal	t9
+ 	REG_L	t4, 4*FFI_SIZEOF_ARG($fp)
+ 	sd	v0, 0(t4)
+-	sw	v1, 8(t4)
++	sw	a0, 8(t4)
+ 	b	epilogue
+ 	
+ retstruct_f_d_soft:	
+@@ -711,18 +711,55 @@ cls_retstruct_d_f:
+ 	b	cls_epilogue
+ 	
+ cls_retstruct_f_d:	
+-	bne	v0, FFI_TYPE_STRUCT_FD, cls_retcomplex_ld_ld
++	bne	v0, FFI_TYPE_STRUCT_FD, cls_retstruct_f_soft
+ 	l.s	$f0, V0_OFF2($sp)
+ 	l.d	$f2, V1_OFF2($sp)
+ 	b	cls_epilogue
+ #else
+ cls_longdouble_soft:
+-	bne	v0, FFI_TYPE_LONGDOUBLE, cls_retcomplex_ld_ld
++	bne	v0, FFI_TYPE_LONGDOUBLE, cls_retstruct_f_soft
+ 	REG_L	v0, V0_OFF2($sp)
+ 	REG_L	a0, V1_OFF2($sp) # not typo, it is a0, I have no idea, gcc does do it
+ 	b	cls_epilogue
+ #endif
+ 
++	# With soft float, a struct of one or two floating-point fields is
++	# returned with the first field in v0 and the second in a0, each
++	# like a scalar of its type.
++cls_retstruct_f_soft:
++	bne	v0, FFI_TYPE_STRUCT_F_SOFT, cls_retstruct_d_soft
++	lw	v0, V0_OFF2($sp)
++	b	cls_epilogue
++
++cls_retstruct_d_soft:
++	bne	v0, FFI_TYPE_STRUCT_D_SOFT, cls_retstruct_f_f_soft
++	ld	v0, V0_OFF2($sp)
++	b	cls_epilogue
++
++cls_retstruct_f_f_soft:
++	bne	v0, FFI_TYPE_STRUCT_FF_SOFT, cls_retstruct_d_d_soft
++	lw	v0, V0_OFF2($sp)
++	lw	a0, (V0_OFF2+4)($sp)
++	b	cls_epilogue
++
++cls_retstruct_d_d_soft:
++	bne	v0, FFI_TYPE_STRUCT_DD_SOFT, cls_retstruct_f_d_soft
++	ld	v0, V0_OFF2($sp)
++	ld	a0, (V0_OFF2+8)($sp)
++	b	cls_epilogue
++
++cls_retstruct_f_d_soft:
++	bne	v0, FFI_TYPE_STRUCT_FD_SOFT, cls_retstruct_d_f_soft
++	lw	v0, V0_OFF2($sp)
++	ld	a0, (V0_OFF2+8)($sp)
++	b	cls_epilogue
++
++cls_retstruct_d_f_soft:
++	bne	v0, FFI_TYPE_STRUCT_DF_SOFT, cls_retcomplex_ld_ld
++	ld	v0, V0_OFF2($sp)
++	lw	a0, (V0_OFF2+8)($sp)
++	b	cls_epilogue
++
+ cls_retcomplex_ld_ld:
+ 	bne	v0, FFI_TYPE_COMPLEX_LDLD, cls_retstruct_small2
+ 	REG_L	t8, A0_OFF2($sp)
diff --git a/package/libs/libffi/patches/016-testsuite-use-register-sized-struct-return-storage.patch b/package/libs/libffi/patches/016-testsuite-use-register-sized-struct-return-storage.patch
